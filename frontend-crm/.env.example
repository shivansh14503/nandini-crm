# =============================================================================
# Nandini CRM Frontend - Environment Configuration Example
# Copy this file to .env.local and adjust values for your environment.
# Reference: src/config/env.ts
# =============================================================================

# Base URL for the backend CRM API server
NEXT_PUBLIC_API_URL=http://localhost:5000

# Enable local mock data / localStorage persistence ("true" or "false")
NEXT_PUBLIC_USE_MOCK=true
