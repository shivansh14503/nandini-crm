# =============================================================================
# Nandini CRM Frontend - Environment Configuration Example
# Copy this file to .env.local and adjust values for your environment.
# Reference: src/config/env.ts
# =============================================================================

# Frontend dev/prod server port (package.json scripts use 8007)
PORT=8007

# Backend API location. Leave NEXT_PUBLIC_API_URL unset to call <current page host>:NEXT_PUBLIC_API_PORT,
# which works unchanged on localhost, LAN IPs and the server IP. Must match the backend's PORT.
NEXT_PUBLIC_API_PORT=8008
# NEXT_PUBLIC_API_URL=https://crm-api.example.com

