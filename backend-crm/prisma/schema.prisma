// Nandini CRM â€” SQL Server schema
//
// Contracts mirror frontend-crm/src/types/*.types.ts; service mappers translate rows to those shapes.
//
// SQL Server rules applied throughout:
// â€¢ No scalar lists: string arrays (productCategory, communicationType, partnerCompanies)
//   are JSON in NVarChar(Max); repeating objects (emails, line items) are child tables.
// â€¢ No multiple cascade paths (error 1785): every cross-entity FK is NoAction/NoAction. Only owned
//   children (emails, line items) cascade from their single parent.
// â€¢ Core entities are soft-deleted (isDeleted / deletedAt), so FKs never block a "delete".
// â€¢ Column widths â‰¥ the frontend's FIELD_MAX_LENGTH (frontend-crm/src/config/fieldLimits.ts).
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

// Connection URL lives in prisma.config.ts (Prisma 7); runtime connects through @prisma/adapter-mssql.
datasource db {
  provider = "sqlserver"
}

// â”€â”€ Identity â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Mapped onto the pre-existing `Users` table (Id, Username, Password, Role) so current accounts keep working.
/// Every column added beyond those four has a default or is nullable, so existing rows migrate without manual
/// backfill (the user_profile migration also splits `fullName` into `firstName` / `lastName` once).
model User {
  // Int keeps the existing auth contract (frontend `User.id: number`).
  id                 Int       @id @default(autoincrement()) @map("Id")
  username           String    @unique @map("Username") @db.NVarChar(50)
  /// bcrypt hash. Legacy plain-text values are re-hashed on the user's next successful login.
  passwordHash       String    @map("Password") @db.NVarChar(255)
  role               String    @default("Sales Executive") @map("Role") @db.NVarChar(50)
  /// Company email, stored trimmed and lower-cased. Unique among active, non-group users (hand-written filtered
  /// index UX_Users_email, migration 20261127090000_calendar_connections; users/userEmail.service.ts is the one
  /// write path). Not @unique: SQL Server unique constraints allow a single NULL, and group logins may share one.
  email              String?   @db.NVarChar(120)
  /// Display name, always `trim(firstName + ' ' + lastName)` when the user edits their profile (My Profile). Read
  /// everywhere a user's name is shown (lookups, audit log, quotation PDFs), so it stays a real column.
  fullName           String    @default("") @db.NVarChar(100)
  /// Given name (My Profile). Backfilled from `fullName` (text before the first space) by the user_profile migration.
  firstName          String?   @db.NVarChar(100)
  /// Family name (My Profile); the rest of `fullName` after the first space. NULL when the user has none.
  lastName           String?   @db.NVarChar(100)
  /// Mobile number, E.164 (My Profile "Mobile"). Quotation PDFs print it as the sales person's phone.
  phone              String?   @db.NVarChar(20)
  /// Desk / landline number, E.164 (My Profile "Office Phone").
  officePhone        String?   @db.NVarChar(20)
  department         String?   @db.NVarChar(50)
  /// Free-text job title (Admin › Users), e.g. "Inside Sales Lead". Shown read-only on My Profile. Not an access rule.
  jobTitle           String?   @db.NVarChar(100)
  /// The user's manager (Admin › Users "Reports to"). Kept when the manager is deactivated; never a cycle (checked
  /// by the API). NO ACTION: a user who still has direct reports can't be deleted.
  reportsToId        Int?
  isActive           Boolean   @default(true)
  isGroupUser        Boolean   @default(false)
  onLeave            Boolean   @default(false)
  /// Set for a new user and after an admin password reset: until they choose a new password, the JWT carries `mcp`
  /// and the API allows only the change-password and sign-out routes (403 PASSWORD_CHANGE_REQUIRED).
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  /// Set when the user changes their own password (POST /api/auth/change-password). NULL = never changed in this CRM.
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  /// Username of the admin who added the user in Admin › Users. NULL for users created before it (seed, SQL).
  createdBy          String?   @db.NVarChar(50)
  /// When an admin last deactivated the user (Admin › Users); NULL while active.
  deactivatedAt      DateTime?
  updatedAt          DateTime  @default(now()) @updatedAt

  photo         UserPhoto?
  preference    UserPreference?
  reportsTo     User?           @relation("UserReportsTo", fields: [reportsToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReports User[]          @relation("UserReportsTo")

  @@index([email])
  @@index([isActive])
  @@index([reportsToId])
  @@map("Users")
}

/// A user's profile photo (bytes in the DB like RecordFile / PdfAsset). A new row (new id) per upload, so the URL
/// /api/user-photos/:id never changes content and can be cached forever. One row per user.
model UserPhoto {
  id        String   @id @default(uuid()) @db.NVarChar(50)
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Detected from the bytes (PNG, JPEG or WebP), not taken from the upload's declared type.
  mimeType  String   @db.NVarChar(50)
  sizeBytes Int
  data      Bytes    @db.VarBinary(Max)
  createdAt DateTime @default(now())
}

/// A user's own notification and availability preferences (My Profile › Notifications). One row per user, created on
/// the first save; no row = every default below (= behaviour before Profile Phase 3). Deleting a user deletes it.
model UserPreference {
  userId                Int       @id
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// Bell (in-app) notifications per kind; false = that kind is not created for this user. Kinds without a column
  /// (calendar_sync_issue) always deliver. notifications/notification.preferences.ts applies them.
  inAppActivityReminder Boolean   @default(true)
  inAppActivityAssigned Boolean   @default(true)
  inAppActivityInvited  Boolean   @default(true)
  inAppContractRenewal  Boolean   @default(true)
  /// The 9 AM morning summary email.
  emailMorningSummary   Boolean   @default(true)
  /// Pre-fills Reminder on activities the user creates: an ACTIVITY_REMINDERS label, 'none' (No reminder), NULL = company default.
  defaultReminder       String?   @db.NVarChar(30)
  /// Out of office, inclusive business-timezone days (UTC midnight, like Holiday / Contract dates). Both set or both NULL.
  outOfOfficeFrom       DateTime? @db.Date
  outOfOfficeTo         DateTime? @db.Date
  outOfOfficeMessage    String?   @db.NVarChar(200)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
}

/// Atomic counters behind document numbers (see src/modules/document-series/documentSeries.sequence.ts).
/// Key = the entity's legacy prefix (`LD`, `QT`, ...), or `LD@2026` for a series that restarts every financial
/// year (2026 = the year that FY starts), so existing counters keep counting when the format changes.
model SequenceCounter {
  prefix       String @id @db.NVarChar(10)
  currentValue Int    @default(0)
}

/// Company-wide document numbering settings (single row, id = 1). Missing row = defaults.
model DocumentSeriesSettings {
  id            Int      @id
  /// Common prefix shared by every series that includes it (e.g. NIPL).
  companyPrefix String   @default("") @db.NVarChar(15)
  /// Joins the parts of a number: "/", "-", "_", "." or "" (none).
  separator     String   @default("/") @db.NVarChar(1)
  /// Month the financial year starts (1-12; 4 = April for India).
  fyStartMonth  Int      @default(4)
  /// YY-YY (26-27), YYYY-YY (2026-27), YYYY-YYYY (2026-2027), YYYY (2026) or YY (26).
  fyFormat      String   @default("YY-YY") @db.NVarChar(10)
  updatedBy     String?  @db.NVarChar(50)
  updatedAt     DateTime @default(now()) @updatedAt
}

/// Company-wide display formats (Admin › Company formats). Single row, id = 1. No row = not customized: every screen keeps
/// its pre-Phase-5 style. Formats change how values are shown, never how they are stored or sent over the API.
model CompanyFormatSettings {
  id             Int      @id
  /// DD-MMM-YYYY, DD MMM YYYY, DD/MM/YYYY, DD-MM-YYYY, MM/DD/YYYY or YYYY-MM-DD (DATE_FORMATS).
  dateFormat     String   @default("DD-MMM-YYYY") @db.NVarChar(12)
  /// 12h or 24h.
  timeFormat     String   @default("12h") @db.NVarChar(3)
  /// indian (12,34,567) or international (1,234,567).
  numberGrouping String   @default("indian") @db.NVarChar(13)
  updatedBy      String?  @db.NVarChar(50)
  updatedAt      DateTime @default(now()) @updatedAt
}

/// A series an admin added for a module, e.g. NIPL/L/26-27/1004. Series always include the financial year and
/// restart every year. No row = the module keeps its original numbering (LD-0001, ...).
model DocumentSeries {
  /// lead | opportunity | quotation | organization | contact | ticket | contract | product
  module                 String   @id @db.NVarChar(30)
  modulePrefix           String   @db.NVarChar(10)
  includeCompanyPrefix   Boolean  @default(false)
  includeFinancialYear   Boolean  @default(false)
  suffix                 String   @default("") @db.NVarChar(10)
  /// Minimum digits of the running number (zero-padded).
  padLength              Int      @default(4)
  /// First number issued; raising it later jumps the series forward (it never goes backwards).
  startingNumber         Int      @default(1)
  /// Restart numbering at `startingNumber` every financial year (requires the FY in the number).
  resetEachFinancialYear Boolean  @default(false)
  updatedBy              String?  @db.NVarChar(50)
  updatedAt              DateTime @default(now()) @updatedAt
}

// â”€â”€ Organizations â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Organization {
  id          String @id @default(uuid()) @db.NVarChar(50)
  accountCode String @unique @db.NVarChar(50)

  // Overview
  organizationName       String    @db.NVarChar(200)
  mailingName            String?   @db.NVarChar(200)
  tradeName              String?   @db.NVarChar(200)
  natureOfBusiness       String?   @db.NVarChar(100)
  accountStatus          String    @default("Active") @db.NVarChar(20)
  inactivityReason       String?   @db.NVarChar(500)
  typeOfEntity           String?   @db.NVarChar(50)
  customerType           String?   @db.NVarChar(50)
  /// Partner organizations only (customerType = Partner): the Partner Company form's Nature of Partner list (partner_nature).
  natureOfPartner        String?   @db.NVarChar(100)
  sapCodeTallyId         String?   @db.NVarChar(30)
  showroomBranchCode     String?   @db.NVarChar(30)
  leadSource             String?   @db.NVarChar(50)
  /// Display name of the parent corporation (free text in the form); parentOrganizationId links it when known.
  memberOf               String?   @db.NVarChar(200)
  parentOrganizationId   String?   @db.NVarChar(50)
  numberOfEmployees      String?   @db.NVarChar(30)
  annualTurnover         String?   @db.NVarChar(30)
  addDescriptionAndScope String?   @db.NVarChar(1000)
  accountVerified        Boolean   @default(false)
  verifiedAt             DateTime?
  verifiedBy             String?   @db.NVarChar(50)
  activeAmc              Boolean   @default(false)
  activeCloud            Boolean   @default(false)
  provideSupport         String    @default("Yes") @db.NVarChar(3)
  assignedTo             String?   @db.NVarChar(50)

  // Billing address (billingStreet mirrors billingAddress for older records)
  billingAddress    String? @db.NVarChar(250)
  billingStreet     String? @db.NVarChar(250)
  /// City master row picked in the form; `billingCity` is its name, written through when an admin renames it.
  billingCityId     Int?
  billingCity       String? @db.NVarChar(80)
  billingState      String? @db.NVarChar(80)
  billingPostalCode String? @db.NVarChar(12)
  billingCountry    String? @db.NVarChar(80)
  billingLatitude   String? @db.NVarChar(30)

  // Shipping address
  shippingAddress        String? @db.NVarChar(250)
  shippingStreet         String? @db.NVarChar(250)
  shippingCityId         Int?
  shippingCity           String? @db.NVarChar(80)
  shippingState          String? @db.NVarChar(80)
  shippingPostalCode     String? @db.NVarChar(12)
  shippingCountry        String? @db.NVarChar(80)
  shippingLongitude      String? @db.NVarChar(30)
  copyAddressFromBilling Boolean @default(false)

  // Tax & bank
  registrationType String? @db.NVarChar(30)
  panNumber        String? @db.NVarChar(10)
  msmeRegnNumber   String? @db.NVarChar(19)
  accountName      String? @db.NVarChar(200)
  bankName         String? @db.NVarChar(100)
  ifscCode         String? @db.NVarChar(11)
  /// Canonical GSTIN; the API also echoes it as the legacy `gstNumber` alias.
  gstNumber        String? @db.NVarChar(15)
  cinNo            String? @db.NVarChar(21)
  tanNumber        String? @db.NVarChar(10)
  accountNo        String? @db.NVarChar(18)
  typeOfAccount    String? @db.NVarChar(30)
  bankAddress      String? @db.NVarChar(250)

  // Partner licensing: string[] as JSON
  partnerCompaniesJson String? @db.NVarChar(Max)

  // Audit & soft delete
  /// Admin-defined custom field values `{ [fieldKey]: value }` (see FormFieldDefinition) as JSON.
  customDataJson String? @db.NVarChar(Max)

  createdBy String    @db.NVarChar(50)
  updatedBy String?   @db.NVarChar(50)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  parentOrganization Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childOrganizations Organization[] @relation("OrganizationHierarchy")
  corporateEmails    EntityEmail[]
  contacts           Contact[]
  opportunities      Opportunity[]
  quotations         Quotation[]
  tickets            Ticket[]
  contracts          Contract[]
  activities         Activity[]
  convertedLeads     Lead[]         @relation("LeadConvertedOrganization")
  billingCityRef     City?          @relation("OrganizationBillingCity", fields: [billingCityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shippingCityRef    City?          @relation("OrganizationShippingCity", fields: [shippingCityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([billingCityId])
  @@index([shippingCityId])
  @@index([organizationName])
  @@index([accountStatus])
  @@index([assignedTo])
  @@index([gstNumber])
  @@index([isDeleted, createdAt])
  /// List filter (status, owner) under row-level access scoping.
  @@index([isDeleted, accountStatus, assignedTo])
}

/// Emails owned by exactly one Organization, Contact, Lead or Referral (one FK set per row).
/// Returned by the API as `corporateEmails` (organizations) / `emailAddresses` (contacts, leads).
model EntityEmail {
  id              String  @id @default(uuid()) @db.NVarChar(50)
  email           String  @db.NVarChar(120)
  isPrimary       Boolean @default(false)
  isOptedOut      Boolean @default(false)
  isInvalidBounce Boolean @default(false)
  sortOrder       Int     @default(0)

  /// Automatic check result: valid | risky | invalid; null = not checked yet or undecided.
  verificationStatus String?   @db.NVarChar(20)
  /// Why, e.g. domain_not_found, disposable, typo, accept_all, rejected_email, domain_ok.
  verificationReason String?   @db.NVarChar(60)
  /// When the check ran; null = never checked.
  verifiedAt         DateTime?

  organizationId String? @db.NVarChar(50)
  contactId      String? @db.NVarChar(50)
  leadId         String? @db.NVarChar(50)
  referralId     String? @db.NVarChar(50)

  // Each parent is the sole cascade path to this table, so cascading is safe here.
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referral     Referral?     @relation(fields: [referralId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
  @@index([contactId])
  @@index([leadId])
  @@index([referralId])
  @@index([email])
}

// â”€â”€ Contacts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Contact {
  id          String @id @default(uuid()) @db.NVarChar(50)
  contactCode String @unique @db.NVarChar(50)

  name                  String  @db.NVarChar(100)
  /// Denormalized display name; organizationId is the link.
  organizationName      String  @db.NVarChar(200)
  organizationId        String? @db.NVarChar(50)
  mobile                String  @db.NVarChar(20)
  officePhone           String? @db.NVarChar(20)
  phone3                String? @db.NVarChar(20)
  phone4                String? @db.NVarChar(20)
  phone5                String? @db.NVarChar(20)
  assignedTo            String  @db.NVarChar(50)
  isPrimaryContact      Boolean @default(false)
  designation           String? @db.NVarChar(100)
  department            String? @db.NVarChar(100)
  leftJob               String  @default("No") @db.NVarChar(3)
  /// string[] as JSON (e.g. ["Call","Email"]).
  communicationTypeJson String? @db.NVarChar(Max)
  doNotCall             Boolean @default(false)
  addDescription        String? @db.NVarChar(2000)

  /// Admin-defined custom field values `{ [fieldKey]: value }` (see FormFieldDefinition) as JSON.
  customDataJson String? @db.NVarChar(Max)

  createdBy String    @db.NVarChar(50)
  updatedBy String?   @db.NVarChar(50)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  emailAddress      EntityEmail[]
  opportunities     Opportunity[]
  quotations        Quotation[]
  tickets           Ticket[]
  contracts         Contract[]
  activities        Activity[]
  activityAttendees ActivityAttendee[]
  convertedLeads    Lead[]             @relation("LeadConvertedContact")

  @@index([organizationId])
  @@index([mobile])
  @@index([name])
  @@index([assignedTo])
  @@index([isDeleted, createdAt])
  /// Scoped lists ("mine" / row-level access) sorted by creation date.
  @@index([isDeleted, assignedTo, createdAt])
}

// ── Referrals ──────────────────────────────────────────────────────────────────

/// People who refer business (CAs, references). Picked as Referred By on leads and opportunities (Lead Source CA /
/// Reference). The Contact form's fields without Left Job, Phone 3–5, Communication Type, Primary Contact, DND and
/// Notes, plus a Status (Active / Inactive; only active referrals are offered in the Referred By picker).
model Referral {
  id String @id @default(uuid()) @db.NVarChar(50)

  name             String  @db.NVarChar(100)
  /// Free text (not linked to an Organization). Migration 20261127110000_referral_company_name carried the former
  /// organizationName over and dropped organizationName / organizationId.
  companyName      String? @db.NVarChar(200)
  mobile           String  @db.NVarChar(20)
  officePhone      String? @db.NVarChar(20)
  assignedTo       String  @db.NVarChar(50)
  designation      String? @db.NVarChar(100)
  department       String? @db.NVarChar(100)
  /// Option of the `referral_status` dropdown: Active / Inactive (system options).
  status           String  @default("Active") @db.NVarChar(30)

  /// Admin-defined custom field values `{ [fieldKey]: value }` (see FormFieldDefinition) as JSON.
  customDataJson String? @db.NVarChar(Max)

  createdBy String    @db.NVarChar(50)
  updatedBy String?   @db.NVarChar(50)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  emailAddress  EntityEmail[]
  leads         Lead[]
  opportunities Opportunity[]

  @@index([mobile])
  @@index([name])
  @@index([assignedTo])
  @@index([status])
  @@index([isDeleted, createdAt])
}

// â”€â”€ Leads â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Lead {
  id       String @id @default(uuid()) @db.NVarChar(50)
  leadCode String @unique @db.NVarChar(50)

  // Overview
  name                String    @db.NVarChar(100)
  mobile              String?   @db.NVarChar(20)
  mailingName         String?   @db.NVarChar(200)
  tradeName           String?   @db.NVarChar(200)
  designation         String?   @db.NVarChar(100)
  leadSource          String?   @db.NVarChar(50)
  /// string[] as JSON.
  productCategoryJson String?   @db.NVarChar(Max)
  followupType        String?   @db.NVarChar(30)
  /// Latest follow-up outcome (shared_customer_response dropdown), picked on every edit.
  customerResponse    String?   @db.NVarChar(100)
  remarks             String?   @db.NVarChar(2000)
  registrationType    String?   @db.NVarChar(30)
  gstNumber           String?   @db.NVarChar(15)
  turnover            String?   @db.NVarChar(30)
  assignedTo          String    @db.NVarChar(50)
  otherPhone          String?   @db.NVarChar(20)
  organizationName    String?   @db.NVarChar(200)
  department          String?   @db.NVarChar(100)
  /// Lead Type (admin dropdown `lead_type`, e.g. Inbound / Outbound / Marketing).
  leadType            String?   @db.NVarChar(30)
  /// Rating: Hot / Warm / Cold. Set by the system, never on a form (not a form-builder field). docs/lead-rating-rules.md
  rating              String?   @db.NVarChar(10)
  /// Why the current Rating, e.g. `Follow-up in 3 days after "Asked to call back later"`.
  ratingReason        String?   @db.NVarChar(200)
  /// Consecutive "Unanswered calls" responses; any other response resets it to 0.
  unansweredCalls     Int       @default(0)
  /// Set while the Rating ages under a "Days since response" rule: the IST day of that response ...
  ratingAgeingFrom    DateTime? @db.Date
  /// ... and the rule's limits plus the response's label `{ limits: { hot, warm }, response }`, snapshot at that save.
  ratingAgeingJson    String?   @db.NVarChar(400)
  status              String    @default("New") @db.NVarChar(30)
  nextFollowupDate    DateTime? @db.Date
  nextFollowupTime    String?   @db.NVarChar(20)
  description         String?   @db.NVarChar(2000)
  noOfEmployee        String?   @db.NVarChar(30)
  /// Name of the Referral picked as Referred By (written through on rename), or legacy free text when `referredById` is null.
  referredBy          String?   @db.NVarChar(200)
  /// The Referral (Referred By) record; shown for Lead Source CA / Reference. See shared/referredBy.ts.
  referredById        String?   @db.NVarChar(50)
  /// Lead Source Partner only: the partner organization (Customer Type Partner) the record came through. See shared/leadSource.ts.
  partnerCompany      String?   @db.NVarChar(200)

  // Primary address
  primaryAddress    String? @db.NVarChar(250)
  /// City master row; `primaryCity` is its name (written through on rename). Same for `otherCityId`.
  primaryCityId     Int?
  primaryCity       String? @db.NVarChar(80)
  primaryState      String? @db.NVarChar(80)
  primaryPostalCode String? @db.NVarChar(12)
  primaryCountry    String? @db.NVarChar(80)
  primaryLatitude   String? @db.NVarChar(30)

  // Other address
  otherAddress        String? @db.NVarChar(250)
  otherCityId         Int?
  otherCity           String? @db.NVarChar(80)
  otherState          String? @db.NVarChar(80)
  otherPostalCode     String? @db.NVarChar(12)
  otherCountry        String? @db.NVarChar(80)
  otherLongitude      String? @db.NVarChar(30)
  copyAddressFromLeft Boolean @default(false)

  // Conversion (set atomically by POST /api/leads/:id/convert)
  convertedAt             DateTime?
  convertedBy             String?   @db.NVarChar(50)
  convertedOrganizationId String?   @db.NVarChar(50)
  convertedContactId      String?   @db.NVarChar(50)
  convertedOpportunityId  String?   @db.NVarChar(50)

  /// Admin-defined custom field values `{ [fieldKey]: value }` (see FormFieldDefinition) as JSON.
  customDataJson String? @db.NVarChar(Max)

  createdBy String    @db.NVarChar(50)
  updatedBy String?   @db.NVarChar(50)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  emailAddress          EntityEmail[]
  convertedOrganization Organization? @relation("LeadConvertedOrganization", fields: [convertedOrganizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  convertedContact      Contact?      @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  convertedOpportunity  Opportunity?  @relation("LeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  primaryCityRef        City?         @relation("LeadPrimaryCity", fields: [primaryCityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  otherCityRef          City?         @relation("LeadOtherCity", fields: [otherCityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referredByRecord      Referral?     @relation(fields: [referredById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([primaryCityId])
  @@index([referredById])
  @@index([otherCityId])
  @@index([status])
  @@index([rating])
  /// The nightly Rating ageing job reads the leads with an ageing snapshot.
  @@index([ratingAgeingFrom])
  @@index([assignedTo])
  @@index([mobile])
  @@index([nextFollowupDate])
  @@index([isDeleted, createdAt])
  /// Scoped lists ("mine" / row-level access) sorted by creation date.
  @@index([isDeleted, assignedTo, createdAt])
}

// â”€â”€ Products â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Product {
  id          String @id @default(uuid()) @db.NVarChar(50)
  productCode String @unique @db.NVarChar(50)

  productName        String   @db.NVarChar(200)
  hsnCode            String?  @db.NVarChar(8)
  category           String?  @db.NVarChar(100)
  type               String?  @db.NVarChar(30)
  manufacturer       String?  @db.NVarChar(100)
  taxType            String?  @default("GST") @db.NVarChar(10)
  taxRate            String?  @db.NVarChar(10)
  // The API returns these as strings (ProductFormData); stored as decimals for reporting.
  discount           Decimal? @db.Decimal(5, 2)
  cost               Decimal? @db.Decimal(18, 2)
  mrp                Decimal? @db.Decimal(18, 2)
  msp                Decimal? @db.Decimal(18, 2)
