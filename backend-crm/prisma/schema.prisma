  @@index([ticketStatus])
  @@index([ticketPriority])
  @@index([assignedTo])
  @@index([dueDate])
  @@index([organizationId])
  @@index([isDeleted, createdAt])
  /// Scoped lists ("mine" / row-level access) sorted by creation date.
