  /// Contact renames write the name through to linked tickets.
  @@index([contactId])
}

// â”€â”€ Contracts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Support contracts (Tally TSS, cloud, ...) sold to an organization, tracked through renewal.
model Contract {
  id             String @id @default(uuid()) @db.NVarChar(50)
  contractNumber String @unique @db.NVarChar(50)

  // Contract details
  contractTitle    String   @db.NVarChar(100)
  status           String   @default("Not Started") @db.NVarChar(30)
  contractValue    Decimal? @db.Decimal(18, 2)
  /// Contract Manager (username); row-level access is scoped on it.
  assignedTo       String   @db.NVarChar(50)
  /// Denormalized display names (organization uppercase); the ids are the links.
  organizationName String   @db.NVarChar(200)
  organizationId   String?  @db.NVarChar(50)
  contact          String   @db.NVarChar(100)
  contactId        String?  @db.NVarChar(50)
  /// Label of the opportunity when it was picked (or text typed without picking one).
  opportunity      String?  @db.NVarChar(200)
  opportunityId    String?  @db.NVarChar(50)
  tallySerialNo    String?  @db.NVarChar(30)

  // Term & renewal
  startDate           DateTime? @db.Date
  endDate             DateTime? @db.Date
  contractPeriod      String?   @db.NVarChar(100)
  /// Local date-time from the form (`YYYY-MM-DDTHH:mm`), stored as datetime like Ticket.dueDate.
  renewalReminderDate DateTime?
  /// string[] as JSON.
  contractTypeJson    String?   @db.NVarChar(Max)

  // Billing
  billNumber  String?   @db.NVarChar(30)
  billDate    DateTime? @db.Date
  billAmount  Decimal?  @db.Decimal(18, 2)
  description String?   @db.NVarChar(2000)

  /// Admin-defined custom field values `{ [fieldKey]: value }` (see FormFieldDefinition) as JSON.
  customDataJson String? @db.NVarChar(Max)

  createdBy String    @db.NVarChar(50)
  updatedBy String?   @db.NVarChar(50)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contactRecord     Contact?      @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunityRecord Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status])
  @@index([assignedTo])
  @@index([organizationId])
  /// Contact renames write the name through to linked contracts.
  @@index([contactId])
  @@index([opportunityId])
  /// "Expiring in 30 Days" and renewal reminders.
  @@index([endDate])
  @@index([renewalReminderDate])
  @@index([isDeleted, createdAt])
  /// Scoped lists ("mine" / row-level access) sorted by creation date.
  @@index([isDeleted, assignedTo, createdAt])
}

// ── Activities ──────────────────────────────────────────────────────────────────

/// A call, meeting, task, note (or any Followup Type) linked to at most one CRM record.
/// startAt / endAt are TRUE UTC instants (unlike Ticket.dueDate / Contract.renewalReminderDate, which are
/// BUSINESS_TIMEZONE wall clocks stored as fake UTC). Notes have no times.
///
/// Hand-written filtered unique index in migration 20261128100000_activity_calendar_sync (Prisma can't model
/// filtered indexes; keep it out of this file and re-check `prisma migrate diff` output after future migrations):
///   UX_Activity_syncKey (syncKey) WHERE syncKey IS NOT NULL   (soft-deleted rows included)
model Activity {
  id String @id @default(uuid()) @db.NVarChar(50)

  // Activity details
  /// Option of shared_followup_type (same key/label as Lead/Opportunity.followupType). 'Task' and 'Note' are system values.
  followupType String @default("Call") @db.NVarChar(30)
  subject      String @db.NVarChar(200)
  /// activity_status: Planned | Completed | Cancelled (fixed).
  status       String @default("Planned") @db.NVarChar(20)
  /// Owner (username); row-level access is scoped on it.
  assignedTo   String @db.NVarChar(50)

  /// Linked record: CrmModuleKey (leads | opportunities | contacts | organizations | quotations | tickets | contracts).
  relatedModule    String? @db.NVarChar(30)
  relatedId        String? @db.NVarChar(50)
  /// Display label of the linked record when picked (Form Builder field `relatedTo`).
  relatedTo        String? @db.NVarChar(200)
  /// Record number of the linked record when picked (LD-0001 …), for display and search.
  relatedCode      String? @db.NVarChar(50)
  /// Denormalized display names; the ids are the links (filled from the related record, editable).
  organizationName String? @db.NVarChar(200)
  organizationId   String? @db.NVarChar(50)
  contact          String? @db.NVarChar(100)
  contactId        String? @db.NVarChar(50)

  // Schedule (null on Notes)
  /// UTC instant. All-day: business-tz midnight of the first day.
  startAt        DateTime?
  /// UTC instant, >= startAt, at most ACTIVITY_MAX_DURATION_DAYS (31) after it. All-day: business-tz midnight after
  /// the last day (exclusive). Defaulted from the type's option meta when omitted.
  endAt          DateTime?
  allDay         Boolean   @default(false)
  /// IANA zone the activity was entered in (Phase 1: always BUSINESS_TIMEZONE). Needed for all-day and calendar sync.
  timeZone       String    @default("Asia/Kolkata") @db.NVarChar(64)
  location       String?   @db.NVarChar(250)
  /// activity_reminder option, value = label ('15 minutes before'); minutes come from ACTIVITY_REMINDER_MINUTES
  /// (activity.schedule.ts; the options are fixed system options). Null = no reminder.
  reminder       String?   @db.NVarChar(30)
  /// System: when the reminder is due (UTC). Null when none applies (Note, not Planned, no reminder, no start, deleted).
  /// Recomputed on every write.
  remindAt       DateTime?
  /// System: set by the reminder job in the same transaction that inserts the notifications; cleared when remindAt
  /// changes. The claim keeps updatedAt unchanged.
  reminderSentAt DateTime?

  // Outcome & notes
  /// Option of shared_customer_response (same field and list as Lead / Opportunity.customerResponse). Recorded only:
  /// never changes a lead's Rating or follow-up, and isn't checked against an opportunity's Sales Stage.
  customerResponse String?   @db.NVarChar(100)
  remarks          String?   @db.NVarChar(2000)
  completedAt      DateTime?
  completedBy      String?   @db.NVarChar(50)

  /// Bumped on every schedule-relevant change (subject, type, times, all-day, location, owner, attendees, status).
  /// Phase 2 iCal SEQUENCE.
  revision Int @default(0)

  /// Admin-defined custom field values `{ [fieldKey]: value }` (see FormFieldDefinition) as JSON.
  customDataJson String? @db.NVarChar(Max)

  /// Where the activity comes from: `crm` (made in the CRM) | `followup` (a lead / opportunity next follow-up, written
  /// by activity.followUp.ts in the record's own transaction; schedule, type, status, owner and related record locked
  /// in the activity UI) | `calendar` (imported from a calendar, Calendar Phase 2 P2-8) | `booking` (booked by a visitor
  /// on a public booking page, Calendar Phase 4). Set only by the system write path. Hand-written filtered unique index
  /// (migration 20261127130000_followup_activities; keep it out of this file):
  ///   UX_Activity_openFollowUp UNIQUE (relatedModule, relatedId) WHERE origin = 'followup' AND status = 'Planned' AND isDeleted = 0
  /// = at most one open follow-up activity per lead / opportunity.
  origin String @default("crm") @db.NVarChar(20)

  // Calendar sync (Calendar Phase 2, P2-3b). Sync jobs write these with `updatedAt` kept unchanged (never a user edit).
  /// RFC 5545 UID of the calendar event (organizer link create response, or a P2-8 import). Replaced when the
  /// organizer link is re-created (owner change, new generation). Not indexed (syncKey is).
  iCalUid           String?   @db.NVarChar(1024)
  /// sha256 hex of `iCalUid + '|' + recurrenceId` (recurrenceId '' in Phase 2); UX_Activity_syncKey. Hashed because
  /// an index on NVarChar(1024) would exceed SQL Server's 1,700-byte key limit.
  syncKey           String?   @db.NVarChar(64)
  /// Organizer of a meeting imported from a calendar (P2-8); null = the owner.
  organizerEmail    String?   @db.NVarChar(254)
  organizerName     String?   @db.NVarChar(200)
  /// Organized outside the CRM's connected users (P2-8): event fields read-only, never pushed.
  externalOrganizer Boolean   @default(false)
  /// When a calendar change was last applied ("Updated from Google Calendar 10:42").
  externalUpdatedAt DateTime?

  // Video meeting (Calendar Phase 3, P3-1): a Google Meet / Microsoft Teams link created with the owner's calendar
  // event by the push (calendar-sync/sync.conference.ts). The API sets provider / state / request; sync jobs write the
  // outcome (state, join URL, id, error) with `updatedAt` kept unchanged.
  /// Requested provider: meet | teams | zoom (P3-2, not offered yet) | null (the form's Video meeting field).
  conferenceProvider String? @db.NVarChar(20)
  /// requested (being created) | ready (join URL known) | failed (conferenceError says why) | null (none).
  conferenceState    String? @db.NVarChar(20)
  /// https only, host allow-list meet.google.com / teams.microsoft.com (calendar-sync/conference.rules.ts).
  conferenceJoinUrl  String? @db.NVarChar(1000)
  /// Meet conference id / Teams online meeting (dial-in conference) id.
  conferenceId       String? @db.NVarChar(200)
  /// Fixed code + short text when the provider couldn't create the link.
  conferenceError    String? @db.NVarChar(300)
  /// n of the last Meet create request (Google `conferenceData.createRequest.requestId` = '<requestedId>-c<n>'),
  /// bumped by the API whenever a new link is asked for (provider chosen, owner changed, Retry).
  conferenceRequest  Int     @default(0)

  createdBy String    @db.NVarChar(50)
  updatedBy String?   @db.NVarChar(50)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  organization  Organization?          @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contactRecord Contact?               @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendees     ActivityAttendee[]
  externalLinks ActivityExternalLink[]

  /// Calendar range (managers / all users). Queries always bound startAt from below (from − 31 days).
  @@index([isDeleted, startAt])
  /// Calendar range per owner.
  @@index([isDeleted, assignedTo, startAt])
  /// Activities tab of a record.
  @@index([relatedModule, relatedId])
  /// Organization / contact roll-ups and name write-through.
  @@index([organizationId])
  @@index([contactId])
  @@index([status])
  /// Reminder sweep: reminderSentAt IS NULL AND remindAt <= now (equality column first).
  @@index([reminderSentAt, remindAt])
  @@index([isDeleted, createdAt])
  /// Scoped lists ("mine" / row-level access) sorted by creation date.
  @@index([isDeleted, assignedTo, createdAt])
  /// P3-1 nightly sweep: video links still `requested` (equality column first).
  @@index([conferenceState, updatedAt])
}

/// One attendee of an Activity: a colleague (username), a Contact, or an outside email. Synced by identity on save
/// (only added / removed / changed rows are written), keeping responseStatus of attendees that stay.
/// Owned by its activity, so it cascades from it (like OpportunityLineItem / EntityEmail).
///
/// Hand-written in migration 20261126090000_activities (Prisma can't model filtered indexes; keep them out of this
/// file and re-check `prisma migrate diff` output after future migrations):
///   UX_ActivityAttendee_user    UNIQUE (activityId, username)  WHERE username IS NOT NULL
///   UX_ActivityAttendee_contact UNIQUE (activityId, contactId) WHERE contactId IS NOT NULL
///   UX_ActivityAttendee_email   UNIQUE (activityId, email)     WHERE kind = 'email'
model ActivityAttendee {
  id             String    @id @default(uuid()) @db.NVarChar(50)
  activityId     String    @db.NVarChar(50)
  /// user | contact | email
  kind           String    @db.NVarChar(10)
  username       String?   @db.NVarChar(50)
  contactId      String?   @db.NVarChar(50)
  email          String?   @db.NVarChar(120)
  /// Display snapshot (user full name, contact name, or the email's name part).
  name           String    @db.NVarChar(200)
  /// needsAction | accepted | tentative | declined (Google vocabulary; Phase 2 maps Microsoft's).
  responseStatus String    @default("needsAction") @db.NVarChar(20)
  respondedAt    DateTime?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contactRecord Contact? @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([activityId])
  /// Row-level access: "activities I attend".
  @@index([username])
  @@index([contactId])
  @@index([email])
}

// â”€â”€ Masters (reference data, seeded) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Nature of Call master: tickets must use one of these names; `priority` suggests the ticket priority.
model NatureOfCall {
  id        String   @id @default(uuid()) @db.NVarChar(50)
  name      String   @unique @db.NVarChar(100)
  /// High | Medium | Low
  priority  String   @db.NVarChar(10)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Channel / referral partner firms involved in support tickets.
/// `companyName` stays globally unique (seeds upsert by it), so a soft-deleted partner keeps its name reserved.
/// `email` (primary of `emailAddressesJson`) and `city` (= `billingCity`) are kept in sync for the lookup projection.
model PartnerCompany {
  id              String   @id @default(uuid()) @db.NVarChar(50)
  partnerName     String   @unique @db.NVarChar(200)
  natureOfPartner String?  @db.NVarChar(100)
  officePhone     String?  @db.NVarChar(20)
  email           String?  @db.NVarChar(120)
  city            String?  @db.NVarChar(80)
  billingCountry  String?  @db.NVarChar(80)
  assignedTo      String?  @db.NVarChar(50)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Overview
  website          String? @db.NVarChar(200)
  addDescription   String? @db.NVarChar(2000)
  description      String? @db.NVarChar(2000)
  principalCompany String? @db.NVarChar(200)
  /// JSON `CorporateEmail[]` (without ids), primary first.
  emailAddressJson String? @db.NVarChar(Max)

  // Bank details
  bankName  String? @db.NVarChar(100)
  branch    String? @db.NVarChar(150)
  accountNo String? @db.NVarChar(18)
  ifscCode  String? @db.NVarChar(11)

  // Billing address (`city` / `billingCountry` above double as billing city / country)
  billingAddress    String? @db.NVarChar(250)
  billingStreet     String? @db.NVarChar(250)
  /// City master row; `billingCity` (and `city`) is its name, written through on rename. Same for `shippingCityId`.
  billingCityId     Int?
  billingCity       String? @db.NVarChar(80)
  billingState      String? @db.NVarChar(80)
  billingPostalCode String? @db.NVarChar(12)

  // Shipping address
  shippingAddress        String? @db.NVarChar(250)
  shippingStreet         String? @db.NVarChar(250)
  shippingCityId         Int?
  shippingCity           String? @db.NVarChar(80)
  shippingState          String? @db.NVarChar(80)
  shippingPostalCode     String? @db.NVarChar(12)
  shippingCountry        String? @db.NVarChar(80)
  copyAddressFromBilling Boolean @default(false)

  // Statutory
  gstNumber      String? @db.NVarChar(15)
  panNumber      String? @db.NVarChar(10)
  cinNo          String? @db.NVarChar(21)
  msmeRegnNumber String? @db.NVarChar(19)
  tanNumber      String? @db.NVarChar(10)

  // Audit & soft delete
  /// Admin-defined custom field values `{ [fieldKey]: value }` (see FormFieldDefinition) as JSON.
  customDataJson String? @db.NVarChar(Max)

  createdBy String    @default("system") @db.NVarChar(50)
  updatedBy String?   @db.NVarChar(50)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  contacts        PartnerCompanyContact[]
  billingCityRef  City?                   @relation("PartnerCompanyBillingCity", fields: [billingCityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shippingCityRef City?                   @relation("PartnerCompanyShippingCity", fields: [shippingCityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([billingCityId])
  @@index([shippingCityId])
  @@index([isDeleted, createdAt])
}

model PartnerCompanyContact {
  id               String   @id @default(uuid()) @db.NVarChar(50)
  partnerCompanyId String   @db.NVarChar(50)
  name             String   @db.NVarChar(100)
  designation      String?  @db.NVarChar(100)
  mobile           String?  @db.NVarChar(20)
  officePhone      String?  @db.NVarChar(20)
  email            String?  @db.NVarChar(120)
  location         String?  @db.NVarChar(80)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partnerCompany PartnerCompany @relation(fields: [partnerCompanyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([partnerCompanyId])
}

/// ISO 3166-1 countries (seeded from CRM_Address_Master.xlsx â†’ Country_Master).
model Country {
  iso2Code    String @id @db.NVarChar(2)
  iso3Code    String @db.NVarChar(3)
  countryName String @db.NVarChar(100)
  numericCode Int

  subdivisions Subdivision[]
  cities       City[]
}

/// ISO 3166-2 states / provinces / regions (seeded from State_Region_Master).
model Subdivision {
  subdivisionCode String @id @db.NVarChar(10)
  countryIso2     String @db.NVarChar(2)
  subdivisionName String @db.NVarChar(150)
  subdivisionType String @db.NVarChar(60)

  country Country @relation(fields: [countryIso2], references: [iso2Code], onDelete: Cascade, onUpdate: NoAction)
  cities  City[]

  @@index([countryIso2])
}

/// The cities address forms offer (seeded from seed-data/cities.csv.gz, built by scripts/buildCityMaster.ts; admins
/// add, rename and remove them). Addresses must pick one: they store its id plus a copy of its name.
model City {
  id              Int     @id @default(autoincrement())
  /// `country|subdivision|searchName` of the city-master row this came from; null for admin-added cities. Kept
  /// through renames, so the seed only adds cities it hasn't loaded before and never re-adds a renamed one.
  seedKey         String? @db.NVarChar(200)
  /// Removed by an admin. Only seeded cities are kept hidden (so a reseed doesn't bring them back); admin-added ones
  /// are deleted outright.
  isHidden        Boolean @default(false)
  countryIso2     String  @db.NVarChar(2)
  /// ISO 3166-2 code; null when the source state couldn't be matched to a subdivision.
  subdivisionCode String? @db.NVarChar(10)
  cityName        String  @db.NVarChar(150)
  /// cityName lowercased, without diacritics or punctuation (`normalizePlaceName`) — what searches match against.
  searchName      String  @db.NVarChar(150)
  /// Upstream population estimate (null when unknown); bigger cities are suggested first.
  population      Int?

  country     Country      @relation(fields: [countryIso2], references: [iso2Code], onDelete: Cascade, onUpdate: NoAction)
  // NoAction: SQL Server rejects a second cascade path (Country → Subdivision → City); the seed deletes cities first.
  subdivision Subdivision? @relation(fields: [subdivisionCode], references: [subdivisionCode], onDelete: NoAction, onUpdate: NoAction)

  organizationBillingAddresses    Organization[]   @relation("OrganizationBillingCity")
  organizationShippingAddresses   Organization[]   @relation("OrganizationShippingCity")
  leadPrimaryAddresses            Lead[]           @relation("LeadPrimaryCity")
  leadOtherAddresses              Lead[]           @relation("LeadOtherCity")
  quotationBillingAddresses       Quotation[]      @relation("QuotationBillingCity")
  quotationShippingAddresses      Quotation[]      @relation("QuotationShippingCity")
  partnerCompanyBillingAddresses  PartnerCompany[] @relation("PartnerCompanyBillingCity")
  partnerCompanyShippingAddresses PartnerCompany[] @relation("PartnerCompanyShippingCity")

  @@index([seedKey])
  @@index([countryIso2, searchName])
  @@index([subdivisionCode, searchName])
}

// ── Audit trail ─────────────────────────────────────────────────────────────────

/// Every change in the CRM, one row per audited event (src/services/audit.service.ts writes it; docs/database-design.md §4.16).
/// An **append-only ledger table** (`LEDGER = ON (APPEND_ONLY = ON)`, created in migration 20261121200000_audit_ledger):
/// rows can only be inserted. UPDATE / DELETE fail for every login, db_owner included, and
/// `sys.sp_verify_database_ledger` proves no row was altered. Never write a migration that updates or deletes rows here:
/// rename old field keys at read time (`FIELD_ALIASES` in src/modules/audit/audit.format.ts) instead.
model AuditLog {
  /// Ever-increasing, so the clustered key appends at the end and `id` order is write order (keyset paging).
  id                        BigInt   @id @default(autoincrement())
  createdAt                 DateTime @default(now())
  /// DATA | CONFIG | SECURITY
  category                  String   @db.NVarChar(12)
  /// CREATE | UPDATE | DELETE | RESTORE | REVERT | STATUS_CHANGE | CONVERT | FOLLOW_UP | IMPORT | LOGIN | LOGIN_FAILED | LOGOUT | ACCESS_DENIED …
  action                    String   @db.NVarChar(30)
  /// INFO | NOTICE | WARNING | CRITICAL
  severity                  String   @default("INFO") @db.NVarChar(10)
  /// App area: a CRM module key (`leads`, `opportunities` …) or an admin area (`form-customization`, `pdf-templates`, `users` …).
  module                    String   @db.NVarChar(40)
  entityType                String   @db.NVarChar(30)
  entityId                  String   @db.NVarChar(50)
  /// Record number at the time (shown only once the module has a document series).
  entityCode                String?  @db.NVarChar(50)
  /// Record name at the time, so renamed and deleted records stay readable.
  entityLabel               String?  @db.NVarChar(200)
  /// `|field|field|` — the fields an update changed ("every change to Assigned To").
  changedFields             String?  @db.NVarChar(1000)
  /// JSON diff `{ field: { from, to } }` or a snapshot, depending on the action.
  changesJson               String?  @db.NVarChar(Max)
  /// Username of the actor, or `system` for background jobs.
  changedBy                 String   @db.NVarChar(50)
  /// `Users.Id` of the actor (null for system jobs).
  actorId                   Int?
  /// The actor's role at the time.
  actorRole                 String?  @db.NVarChar(50)
  /// UI (the CRM web app) | API (any other client) | IMPORT | JOB
  source                    String?  @db.NVarChar(10)
  /// Same value on every entry written by one request, import or job run.
  requestId                 String?  @db.NVarChar(50)
  /// Sign-in session (JWT id) the request belonged to.
  sessionId                 String?  @db.NVarChar(50)
  httpMethod                String?  @db.NVarChar(10)
  /// Route pattern, e.g. `/api/leads/:id`.
  route                     String?  @db.NVarChar(200)
  /// Screen the user was on, e.g. `/leads/123` (sent by the web app).
  page                      String?  @db.NVarChar(300)
  ipAddress                 String?  @db.NVarChar(45)
  userAgent                 String?  @db.NVarChar(400)
  /// The entry an undo / restore reverses.
  revertsId                 BigInt?
  /// SQL Server ledger columns (hidden, generated). Declared so schema diffs leave them alone; not in the client.
  ledgerStartTransactionId  BigInt   @default(dbgenerated()) @map("ledger_start_transaction_id") @ignore
  ledgerStartSequenceNumber BigInt   @default(dbgenerated()) @map("ledger_start_sequence_number") @ignore

  @@index([createdAt])
  @@index([entityType, entityId, id])
  @@index([changedBy, createdAt])
  @@index([module, createdAt])
  @@index([category, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@index([ipAddress, createdAt])
  @@index([revertsId])
}

/// An export of the audit log (Admin › Audit Log "Export"): the filter, its progress and the file it produced under
/// AUDIT_EXPORT_DIR (`<id>.csv|xlsx`, removed after 24 hours). Downloadable by the admin who asked for it; every
/// finished export also writes an EXPORT entry to AuditLog.
model AuditExport {
  id          String    @id @default(uuid()) @db.NVarChar(50)
  /// Username of the admin who asked for it (the only one who can download it).
  requestedBy String    @db.NVarChar(50)
  /// csv | xlsx
  format      String    @db.NVarChar(10)
  /// The list filter as sent (GET /api/admin/audit-logs query, JSON).
  filtersJson String    @db.NVarChar(Max)
  /// queued | running | completed | failed | expired (file removed after 24 hours)
  status      String    @db.NVarChar(20)
  /// Entries written so far (all of them once completed).
  rowCount    Int       @default(0)
  /// More entries matched than the format's cap; only the newest were written.
  truncated   Boolean   @default(false)
  /// Download name, e.g. `audit-log-2026-11-23-1015.csv`.
  fileName    String?   @db.NVarChar(200)
  fileSize    Int?
  /// Why it failed.
  message     String?   @db.NVarChar(500)
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([requestedBy, createdAt])
  @@index([createdAt])
}

/// A SQL Server ledger digest (`sys.sp_generate_database_ledger_digest`): the hash of the latest ledger block, which
/// "Verify integrity" checks the AuditLog ledger against. The trusted copy is the JSON file under AUDIT_DIGEST_DIR
/// (outside the database); this row only lists digests on the Admin › Audit Log screen.
model AuditDigest {
  id             Int       @id @default(autoincrement())
  blockId        BigInt
  /// Block hash, hex.
  hash           String    @db.NVarChar(100)
  lastCommitTime DateTime?
  digestTime     DateTime
  /// The digest exactly as SQL Server returned it.
  digestJson     String    @db.NVarChar(Max)
  /// File name under AUDIT_DIGEST_DIR.
  fileName       String    @db.NVarChar(260)
  /// JOB (nightly) | MANUAL ("Save a digest now") | VERIFY (taken by "Verify integrity")
  source         String    @db.NVarChar(10)
  createdBy      String    @db.NVarChar(50)
  createdAt      DateTime  @default(now())

  @@index([createdAt])
}

// ── Form & dropdown customization (admin-managed) ─────────────────────────────

/// A named list of dropdown options (e.g. lead_status). Shared categories (module = 'shared') feed several forms.
model DropdownCategory {
  id          String    @id @default(uuid()) @db.NVarChar(50)
  key         String    @unique @db.NVarChar(80)
  label       String    @db.NVarChar(120)
  /// 'shared' or a CRM module key: 'leads' | 'opportunities' | 'quotations' | 'organizations' | 'contacts' | 'products' |
  /// 'tickets' | 'contracts' | 'activities' | 'partner-companies' | 'referrals' (CATEGORY_MODULES in formConfig.defaults.ts)
  module      String    @db.NVarChar(40)
  description String?   @db.NVarChar(300)
  isSystem    Boolean   @default(false)
  /// Set when an admin deletes a built-in dropdown: the row stays as a tombstone (options removed) so start-up
  /// seeding doesn't recreate it. Deleted rows are hidden everywhere.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  options DropdownOption[]
  fields  FormFieldDefinition[]
}

/// One option of a DropdownCategory. Deleting removes the row; records that stored its value keep the raw text.
/// System options drive backend logic (e.g. lead 'Converted') and cannot be deleted or have their value changed.
model DropdownOption {
  id         String   @id @default(uuid()) @db.NVarChar(50)
  categoryId String   @db.NVarChar(50)
  value      String   @db.NVarChar(200)
  label      String   @db.NVarChar(200)
  metaJson   String?  @db.NVarChar(Max)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  isSystem   Boolean  @default(false)
  /// Pre-selected on new records (a single-choice field takes the first one in order).
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Owned by exactly one category, so cascading is safe.
  category DropdownCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([categoryId, value])
  @@index([categoryId, isActive, sortOrder])
}

/// Per-module form layout: built-in fields (isSystem) can be relabelled / reordered / resized; custom fields
/// (fieldKey prefixed cf_) store their values in the entity's customDataJson. Core-locked fields can't be hidden or made optional.
model FormFieldDefinition {
  id                  String   @id @default(uuid()) @db.NVarChar(50)
  module              String   @db.NVarChar(40)
  fieldKey            String   @db.NVarChar(80)
  label               String   @db.NVarChar(120)
  fieldType           String   @db.NVarChar(30)
  tabKey              String   @db.NVarChar(40)
  /// Display name of an admin-created (custom) tab; null on the built-in tabs (their names come from MODULE_TABS).
  tabLabel            String?  @db.NVarChar(120)
  sectionKey          String   @db.NVarChar(80)
  sectionLabel        String   @db.NVarChar(120)
  sortOrder           Int      @default(0)
  fieldSize           String?  @db.NVarChar(10)
  placeholder         String?  @db.NVarChar(200)
  hint                String?  @db.NVarChar(200)
  defaultValue        String?  @db.NVarChar(500)
  isRequired          Boolean  @default(false)
  isCoreLocked        Boolean  @default(false)
  isSystem            Boolean  @default(false)
  isActive            Boolean  @default(true)
  isVisibleInForm     Boolean  @default(true)
  isVisibleInDrawer   Boolean  @default(true)
  /// Contacts / organizations / opportunities: shown on the Convert Lead form (independent of isVisibleInForm).
  isVisibleInConvert  Boolean  @default(false)
  /// Convert Lead's own settings for the field (contacts / organizations / opportunities). null → the record's form
  /// setting applies, so changes made there reach Convert Lead. convertFieldSize also takes 'auto' (explicitly no width).
  convertIsRequired   Boolean?
  convertFieldSize    String?  @db.NVarChar(10)
  /// Convert Lead order: the fields that have one fill, in this order, the places they hold on the record's form.
  convertSortOrder    Int?
  /// Convert Lead section of the field (ModuleSetting `convertSections`); null → its section on the record's form.
  convertSectionKey   String?  @db.NVarChar(80)
  dropdownCategoryId  String?  @db.NVarChar(50)
  validationRulesJson String?  @db.NVarChar(Max)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  dropdownCategory DropdownCategory? @relation(fields: [dropdownCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([module, fieldKey])
  @@index([module, isActive, sortOrder])
}

// ─── PDF generation ─────────────────────────────────────────────────────────────

/// Admin-managed Handlebars templates rendered to PDF (src/modules/pdf). HTML/CSS are sanitized on save.
/// System templates (isSystem) are seeded from code and read-only except isActive / isDefault.
/// pageSize / orientation have no DB default (see the Quotation.currency note); the API always sets them.
model PdfTemplate {
  id           String    @id @default(uuid()) @db.NVarChar(50)
  name         String    @db.NVarChar(120)
  /// QUOTATION (PDF_MODULES in src/modules/pdf/pdf.types.ts)
  module       String    @db.NVarChar(30)
  description  String?   @db.NVarChar(500)
  isSystem     Boolean   @default(false)
  isDefault    Boolean   @default(false)
  isActive     Boolean   @default(true)
  /// A4 | Letter | Legal
  pageSize     String    @db.NVarChar(10)
  /// portrait | landscape
  orientation  String    @db.NVarChar(10)
  /// JSON PdfDocument (src/modules/pdf/document/schema.ts): page setup, theme and the header / body / footer
  /// sections, columns and blocks. pageSize / orientation above mirror it for listing.
  documentJson String    @db.NVarChar(Max)
  /// Optimistic-concurrency counter; bumped on every update.
  version      Int       @default(1)
  createdBy    String    @db.NVarChar(50)
  updatedBy    String?   @db.NVarChar(50)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?

  @@index([module, isActive, isDeleted])
}

/// Images (logos) embedded into PDF templates as data: URIs. PNG / JPEG / WebP, at most 1 MB.
model PdfAsset {
  id        String   @id @default(uuid()) @db.NVarChar(50)
  key       String   @unique @db.NVarChar(80)
  fileName  String   @db.NVarChar(200)
  mimeType  String   @db.NVarChar(50)
  sizeBytes Int
  data      Bytes    @db.VarBinary(Max)
  createdBy String   @db.NVarChar(50)
  createdAt DateTime @default(now())
}

/// A file uploaded to a record field (an opportunity's Upload Doc). Uploaded first, then linked when the record saves.
model RecordFile {
  id        String   @id @default(uuid()) @db.NVarChar(50)
  /// CRM module the file was uploaded for (`opportunities`).
  module    String   @db.NVarChar(30)
  fileName  String   @db.NVarChar(200)
  mimeType  String   @db.NVarChar(100)
  sizeBytes Int
  data      Bytes    @db.VarBinary(Max)
  createdBy String   @db.NVarChar(50)
  createdAt DateTime @default(now())

  documents Document[]

  @@index([module, createdAt])
}

// ── Documents ──────────────────────────────────────────────────────────────────

/// Documents module (Activities › Documents): the document an opportunity records in its Documentation section
/// (Add Document Yes: Document No, Document Date, Upload Doc). Written only by the opportunity form, one per
/// opportunity; switching Add Document to No deletes it. Listed while its opportunity is live.
model Document {
  id              String    @id @default(uuid()) @db.NVarChar(50)
  opportunityId   String    @unique @db.NVarChar(50)
  documentNo      String?   @db.NVarChar(30)
  documentDate    DateTime? @db.Date
  /// Upload Doc (RecordFile). Required by the form; NULL only on documents migrated without a file.
  documentFileId  String?   @db.NVarChar(50)

  createdBy String   @db.NVarChar(50)
  updatedBy String?  @db.NVarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity  Opportunity @relation(fields: [opportunityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documentFile RecordFile? @relation(fields: [documentFileId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([documentFileId])
  @@index([createdAt])
}

/// Builder library: a section or block saved by an admin, shared by every template of the module and inserted as a copy.
model PdfSavedItem {
  id          String    @id @default(uuid()) @db.NVarChar(50)
  module      String    @db.NVarChar(30)
  name        String    @db.NVarChar(120)
  /// section | block
  kind        String    @db.NVarChar(10)
  /// JSON SavedItemContent ({ kind, section } | { kind, block }).
  contentJson String    @db.NVarChar(Max)
  createdBy   String    @db.NVarChar(50)
  createdAt   DateTime  @default(now())
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  @@index([module, isDeleted])
}

/// A user's table filter (Filter dialog on every list): `recent` = the last 10 applied, `saved` = named via "Save filter as".
/// Personal UI state, so rows are hard-deleted (recents are trimmed, saved ones removed by their owner).
model TableFilter {
  id           String   @id @default(uuid()) @db.NVarChar(50)
  username     String   @db.NVarChar(50)
  /// CrmModuleKey, e.g. leads.
  module       String   @db.NVarChar(30)
  /// recent | saved
  kind         String   @db.NVarChar(10)
  /// Saved filters only.
  name         String?  @db.NVarChar(120)
  /// JSON TableFilterCriteria ({ conditions, sort? }).
  criteriaJson String   @db.NVarChar(Max)
  /// Hash of the normalized criteria: re-applying the same filter bumps the existing recent entry.
  fingerprint  String   @db.NVarChar(64)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([username, module, kind])
}

// ── Notifications & outgoing mail ──────────────────────────────────────────────

/// In-app notification for one user (navbar bell): activity reminders, assignments and invitations, contract renewal
/// reminders (src/modules/notifications). Personal state: hard-deleted by the nightly retention job
/// (NOTIFICATION_RETENTION_DAYS: read rows older than that, any row older than twice that), never audited.
model Notification {
  id           String    @id @default(uuid()) @db.NVarChar(50)
  /// Recipient (username, like TableFilter).
  username     String    @db.NVarChar(50)
  /// activity_reminder | activity_assigned | activity_invited | contract_renewal | calendar_sync_issue | booking_created
  kind         String    @db.NVarChar(40)
  title        String    @db.NVarChar(200)
  body         String?   @db.NVarChar(500)
  /// CrmModuleKey of the record it is about (activities | contracts) and its id.
  entityModule String?   @db.NVarChar(30)
  entityId     String?   @db.NVarChar(50)
  /// The moment the notification is about (activity start, renewal reminder), UTC.
  dueAt        DateTime?
  /// Who caused it (username) or 'system'.
  actor        String?   @db.NVarChar(50)
  /// Idempotency, one per event and recipient (builders in notification.reminders.ts).
  dedupeKey    String    @unique @db.NVarChar(200)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  /// Unread count / unread list of the bell.
  @@index([username, readAt])
  /// The bell list, newest first (keyset paging on createdAt, id).
  @@index([username, createdAt])
  /// Retention purge.
  @@index([createdAt])
}

/// One outgoing email (src/services/mail.service.ts): idempotency and an audit trail of what the CRM mailed whom
/// (the morning summary today; quotation emails later). A send first claims its row (status `sending`, unique
/// dedupeKey), then marks it `sent` or `failed`. A personal / system log like Notification: not audited, rows older
/// than EMAIL_LOG_RETENTION_DAYS are hard-deleted by the nightly job.
model EmailLog {
  id         String    @id @default(uuid()) @db.NVarChar(50)
  /// morning_summary | morning_summary_test | …
  kind       String    @db.NVarChar(40)
  /// Recipient's username when the email goes to a CRM user.
  toUsername String?   @db.NVarChar(50)
  toEmail    String    @db.NVarChar(120)
  subject    String    @db.NVarChar(200)
  /// One send per key, e.g. `morning_summary:<YYYY-MM-DD>:<username>`; one-off sends get a unique key.
  dedupeKey  String    @unique @db.NVarChar(200)
  /// sending | sent | failed | skipped (mail turned off)
  status     String    @db.NVarChar(20)
  /// Why the send failed (SMTP response or connection error, never credentials).
  error      String?   @db.NVarChar(500)
  /// Message-ID the SMTP server accepted the message under.
  messageId  String?   @db.NVarChar(250)
  /// Send attempts so far (a failed send is retried by a later run while attempts < 3).
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([createdAt])
  @@index([kind, createdAt])
}

/// Scorecard of a module's list screen (the summary cards above the table): the dropdown field the cards count by,
/// an optional amount field each card totals, a colour per option value, and whether those colours also mark the
/// field in the list column / record drawer. One row per module (no row = the screen's built-in cards); admins edit
/// it under Admin › List Scorecards.
model ModuleScorecard {
  /// CrmModuleKey, e.g. leads.
  module           String   @id @db.NVarChar(40)
  /// Form field key of a single-choice dropdown field of the module (built-in or custom).
  fieldKey         String   @db.NVarChar(80)
  /// Form field key of an amount / number field summed per card; null = counts only.
  currencyFieldKey String?  @db.NVarChar(80)
  /// JSON [{ value, color: "#RRGGBB", hidden? }] in card order (option values of the field's dropdown).
  optionsJson      String   @db.NVarChar(Max)
  listViewColor    Boolean  @default(false)
  /// Colors also mark the field in the record drawer.
  drawerViewColor  Boolean  @default(false)
  /// false = an admin switched the module's cards off (settings kept): the list shows no cards. The list column and
  /// drawer colors follow their own switches.
  enabled          Boolean  @default(true)
  /// Wording of the "All" card; null = the screen's own ("All Leads").
  allLabel         String?  @db.NVarChar(60)
  /// Optimistic-concurrency counter; bumped on every save.
  version          Int      @default(1)
  updatedBy        String?  @db.NVarChar(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Admin-designed record side drawer of a module (Admin › Form Customization › Drawer Layout): header, badges and the
/// sections / blocks of each form tab. One row per module; no row = the drawer's built-in layout. Hard-deleted on reset.
model DrawerLayout {
  /// DRAWER_LAYOUT_MODULES (src/modules/drawer-layouts/document/schema.ts), e.g. leads.
  module     String   @id @db.NVarChar(40)
  /// JSON DrawerLayoutDocument (same file), validated on save; a row that no longer parses is ignored.
  layoutJson String   @db.NVarChar(Max)
  /// Optimistic-concurrency counter; bumped on every save.
  version    Int      @default(1)
  updatedBy  String?  @db.NVarChar(50)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// A section an admin saved to the Drawer Layout builder's "Pieces" library. Inserting one places a copy, so later
/// edits or deletes never change a layout. Hard-deleted.
model DrawerPiece {
  id          String   @id @default(uuid()) @db.NVarChar(50)
  module      String   @db.NVarChar(40)
  name        String   @db.NVarChar(120)
  /// JSON DrawerSection.
  sectionJson String   @db.NVarChar(Max)
  createdBy   String   @db.NVarChar(50)
  createdAt   DateTime @default(now())

  @@index([module])
}

/// A module-level setting an admin edits in Form Builder outside the form's fields, as one JSON value per
/// (module, key). E.g. leads › ratingNewLead: the Rating limits for new leads (docs/lead-rating-rules.md).
model ModuleSetting {
  /// CrmModuleKey, e.g. leads.
  module    String   @db.NVarChar(40)
  key       String   @db.NVarChar(80)
  valueJson String   @db.NVarChar(Max)
  updatedBy String?  @db.NVarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([module, key])
}

/// One admin bulk email check (Settings › Email Validation): the addresses picked, checked one at a time in the
/// API process. Each address costs at most one provider credit; the results are written onto every EntityEmail
/// row with that address. Unfinished runs resume when the API starts.
model EmailValidationRun {
  id                 String    @id @default(uuid()) @db.NVarChar(50)
  /// queued | running | completed | cancelled | stopped (provider out of credits / unreachable)
  status             String    @db.NVarChar(20)
  /// string[] of lowercased addresses as JSON, in the order they are checked.
  emailsJson         String    @db.NVarChar(Max)
  total              Int
  /// How many of `emailsJson` are done (the next one to check is at this index).
  processed          Int       @default(0)
  validCount         Int       @default(0)
  riskyCount         Int       @default(0)
  invalidCount       Int       @default(0)
  /// Provider couldn't decide; the address keeps its previous result.
  undecidedCount     Int       @default(0)
  /// Why a run stopped early, shown to the admin.
  message            String?   @db.NVarChar(500)
  /// single = one provider call per address (small runs); list = the provider's List API (one CSV upload, polled).
  mode               String    @default("single") @db.NVarChar(10)
  /// list mode: local_checks | uploading | provider_running | provider_waiting (not enough credits) | importing
  phase              String?   @db.NVarChar(30)
  /// list mode: addresses that passed the free checks and go to the provider, as a JSON string[].
  providerEmailsJson String?   @db.NVarChar(Max)
  /// list mode: the provider's job id (status polling, report download, delete).
  providerJobId      String?   @db.NVarChar(64)
  /// list mode: the provider's progress, 0–100.
  providerProgress   Int?
  lastPolledAt       DateTime?
  startedBy          String    @db.NVarChar(50)
  createdAt          DateTime  @default(now())
  finishedAt         DateTime?

  @@index([createdAt])
}

// ── Holidays (Admin › Holidays) ────────────────────────────────────────────────

/// A company holiday an admin keeps in Admin › Holidays. Active holidays show on everyone's calendar as all-day
/// entries, and the activity forms warn when something is scheduled on one. One row per (date, occasion): the unique
/// index (case-insensitive under the database collation) stops the same holiday being added or imported twice.
model Holiday {
  id            String   @id @default(uuid()) @db.NVarChar(50)
  occasion      String   @db.NVarChar(100)
  /// The day. A yearly holiday (repeatsYearly) is stored on its day and month in 1904 (YEARLY_ANCHOR_YEAR, a leap
  /// year below the accepted range, so 29 Feb fits and no one-off date can match it); the API shows it as MM-DD.
  holidayDate   DateTime @db.Date
  /// Repeats every year on the same day and month (29 Feb falls on 28 Feb in other years).
  repeatsYearly Boolean  @default(false)
  /// Active | Inactive, the same Status options as Referrals. Only Active holidays reach the calendar.
  status        String   @default("Active") @db.NVarChar(30)
  createdBy     String   @db.NVarChar(50)
  updatedBy     String?  @db.NVarChar(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([holidayDate, occasion])
  @@index([status, holidayDate])
}

// ── Integrations (Admin › API Integrations) ────────────────────────────────────

/// Company-wide set-up of one external provider (Admin › API Integrations). One row per provider, created on first
/// save. Secrets are AES-256-GCM sealed (src/services/secretBox.ts) and never returned by the API.
model IntegrationProvider {
  /// 'google' | 'microsoft' | 'zoom' (INTEGRATION_PROVIDERS in integration.constants.ts)
  provider        String    @id @db.NVarChar(30)
  enabled         Boolean   @default(false)
  /// google: the service account's numeric client_id, taken from the uploaded key (never typed in);
  /// microsoft / zoom: the app's client id.
  clientId        String?   @db.NVarChar(200)
  /// Sealed JSON (AAD "IntegrationProvider:<provider>:secrets"): google { serviceAccountKey } (the whole key JSON as
  /// text); microsoft { clientSecret }; zoom { clientSecret, webhookSecret? }.
  secretsEnc      String?   @db.NVarChar(Max)
  /// Key id of secretsEnc (rotation).
  keyId           String?   @db.NVarChar(8)
  /// Non-secret hints: google { serviceAccountKey: { clientEmail, clientId, projectId, privateKeyId, updatedAt,
  /// updatedBy } }; microsoft / zoom { clientSecret: { last4, updatedAt, updatedBy, expiresOn? }, webhookSecret?: {…} }.
  secretHintsJson String?   @db.NVarChar(Max)
  /// Non-secret settings: google { domains: string[] }; microsoft { tenantId, domains: string[] }; zoom {}.
  /// Company calendar settings live in ModuleSetting activities/calendarSync.
  settingsJson    String?   @db.NVarChar(Max)
  /// Credentials version: bumped whenever the key, client id, secret or tenant changes. Part of the in-memory token
  /// cache key, so grants minted with old credentials are never used again.
  clientVersion   Int       @default(1)
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  /// Fixed code + short provider text (≤ 300) for admins.
  lastTestMessage String?   @db.NVarChar(300)
  /// App-level health found while syncing (not by a manual test): unknown | ok | error.
  healthStatus    String    @default("unknown") @db.NVarChar(10)
  /// TokenErrorCode of the last app-level failure (delegation_missing, key_invalid, invalid_client, …).
  healthCode      String?   @db.NVarChar(50)
  healthAt        DateTime?
  updatedBy       String?   @db.NVarChar(50)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}

/// One employee's company calendar as the CRM syncs it (Calendar Phase 2, admin-managed: P2-2b). Created and stopped by
/// the enrolment reconcile (calendar-sync/enrolment.ts), never by the employee. No tokens: access tokens are minted per
/// call from the company credentials (IntegrationProvider) and kept only in process memory. One row per (user,
/// provider, mailbox) identity; an email or provider change stops the old row and starts a new one. Usernames are
/// strings, as everywhere (no FK to Users).
///
/// Hand-written filtered unique indexes (migration 20261128090000_calendar_admin_connect; Prisma can't model filtered
/// indexes, so keep them out of this file and re-check `prisma migrate diff` output after future migrations):
///   UX_CalendarConnection_user    (username)               WHERE status IN ('pending','ok','error')
///   UX_CalendarConnection_mailbox (provider, accountEmail) WHERE status IN ('pending','ok','error')
model CalendarConnection {
  id                  String    @id @default(uuid()) @db.NVarChar(50)
  username            String    @db.NVarChar(50)
  /// google | microsoft | fake (dev-only test provider, CALENDAR_FAKE_PROVIDER)
  provider            String    @db.NVarChar(30)
  /// The user's company email at enrolment, lower-cased (= Google `sub` / Graph /users/{mailbox}).
  accountEmail        String    @db.NVarChar(254)
  /// pending (enrolled, not checked yet) | ok | error (user-level problem) | stopped (row kept for link history)
  status              String    @default("pending") @db.NVarChar(20)
  /// error: user-level code (user_not_found, user_unavailable, calendar_unavailable, mailbox_out_of_scope, no_mailbox);
  /// stopped: excluded | user_inactive | email_changed | provider_changed | provider_removed | no_email | oauth_retired
  statusReason        String?   @db.NVarChar(50)
  /// How the provider was chosen: domain | override
  source              String    @default("domain") @db.NVarChar(10)
  /// 'primary' (Google) / '' = default calendar (Graph).
  calendarId          String    @default("primary") @db.NVarChar(200)
  /// Google nextSyncToken / Graph @odata.deltaLink (P2-5). Not a credential, but never logged. Null = full sync next.
  syncCursor          String?   @db.NVarChar(Max)
  /// Graph calendarView window of the delta link (re-baselined monthly).
  syncWindowStart     DateTime?
  syncWindowEnd       DateTime?
  fullSyncAt          DateTime?
  /// First-sync backfill (P2-3c): backfilledAt = its run stamp (claimed when the first run starts, reused by a re-run);
  /// backfillCount = activities it copied, written last (null = not done).
  backfilledAt        DateTime?
  backfillCount       Int?
  lastPulledAt        DateTime?
  lastPushedAt        DateTime?
  lastSuccessAt       DateTime?
  lastCheckedAt       DateTime?
  /// Earliest next health check after a user-level error (backoff 15 min → 1 h → 6 h → 24 h).
  nextCheckAt         DateTime?
  lastErrorAt         DateTime?
  lastErrorCode       String?   @db.NVarChar(100)
  /// Provider text for admins (≤ 300; never shown to the employee, never logged at info).
  lastErrorMessage    String?   @db.NVarChar(300)
  consecutiveFailures Int       @default(0)
  /// Per-connection mutex for push / pull / rsvp / channel jobs (P2-3).
  leaseId             String?   @db.NVarChar(50)
  leaseUntil          DateTime?
  /// When this identity was (re-)enrolled.
  enrolledAt          DateTime  @default(now())
  stoppedAt           DateTime?
  /// Username of the admin whose change stopped it, or 'system'.
  stoppedBy           String?   @db.NVarChar(50)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  links    ActivityExternalLink[]
  channels CalendarWatchChannel[]

  @@index([username, status])
  @@index([provider, status])
  @@index([status, nextCheckAt])
}

/// A Google push channel or Microsoft Graph subscription for one connection (Calendar Phase 2 P2-7, webhooks). Own
/// table because Google renewal overlaps two channels for a while (no renew call). Created / renewed / stopped by
/// calendar-sync/sync.channels.ts; looked up by calendar-sync/webhook.service.ts. Not audited (system state).
model CalendarWatchChannel {
  /// Our id: the Google channel id (≤ 64 chars) / our id for a Graph subscription. `w<8 hex address tag>-<uuid>`.
  id           String   @id @db.NVarChar(64)
  connectionId String   @db.NVarChar(50)
  provider     String   @db.NVarChar(30)
  /// Google resourceId / Graph subscription id.
  externalId   String?  @db.NVarChar(200)
  /// Ring key id used for the token / clientState HMAC.
  tokenKeyId   String   @db.NVarChar(8)
  /// Graph clientState generation (bumped on re-create).
  generation   Int      @default(1)
  expiresAt    DateTime
  /// active | stopped | failed
  status       String   @default("active") @db.NVarChar(20)
  createdAt    DateTime @default(now())

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([connectionId, status])
  @@index([externalId])
  @@index([status, expiresAt])
}

/// One Activity as seen in one connected calendar, and the durable push outbox (`dirtyAt`): Calendar Phase 2 P2-3b.
/// role 'organizer' = the copy the CRM writes (the owner's calendar); 'attendee' = a connected colleague's invitation
/// copy (P2-8, replies only). Owned by its activity (cascades); NO ACTION to the connection (rows are kept when
/// stopped and their links become 'detached'). Not audited (system state, like Notification).
///
/// Hand-written filtered unique index in migration 20261128100000_activity_calendar_sync (Prisma can't model
/// filtered indexes; keep it out of this file and re-check `prisma migrate diff` output after future migrations):
///   UX_ActivityExternalLink_event (connectionId, externalEventKey) WHERE externalEventKey IS NOT NULL
model ActivityExternalLink {
  id                String    @id @default(uuid()) @db.NVarChar(50)
  activityId        String    @db.NVarChar(50)
  connectionId      String    @db.NVarChar(50)
  /// google | microsoft | fake (the connection's provider)
  provider          String    @db.NVarChar(30)
  /// organizer | attendee
  role              String    @default("organizer") @db.NVarChar(10)
  /// pending | synced | error | cancelled | removed_remote | unsupported | detached
  state             String    @default("pending") @db.NVarChar(20)
  /// send | withhold (a private copy without attendees: created by someone other than the owner (D41), or by the
  /// connect backfill (P2-3c))
  invites           String    @default("send") @db.NVarChar(10)
  /// JSON array of lower-cased emails a non-owner added to an already-sent event: not invited until the owner sends
  /// them (D41).
  heldAttendeesJson String?   @db.NVarChar(Max)
  /// Re-create counter (part of the requested id).
  generation        Int       @default(0)
  /// Google event id we ask for / Graph transactionId: 'crm' + 40 hex of sha256(activityId:connectionId:generation).
  requestedId       String    @db.NVarChar(64)
  externalEventId   String?   @db.NVarChar(1024)
  /// sha256 hex of externalEventId (the indexed key; NVarChar(1024) would exceed the 1,700-byte key limit).
  externalEventKey  String?   @db.NVarChar(64)
  iCalUid           String?   @db.NVarChar(1024)
  /// Google etag / Graph @odata.etag of the last version we wrote or read.
  etag              String?   @db.NVarChar(200)
  /// Google htmlLink / Graph webLink ("Open in Google Calendar"), shown to the owner / editors only.
  htmlLink          String?   @db.NVarChar(2000)
  providerUpdatedAt DateTime?
  /// { crm: CrmShape, provider: ProviderShape } (calendar-sync/sync.shapes.ts): the last state both sides agreed on.
  /// Null until the first successful push.
  baseJson          String?   @db.NVarChar(Max)
  /// Activity.updatedAt when the base was taken.
  crmSyncedAt       DateTime?
  /// Outbox: set inside the activity's own transaction; cleared by the push with compare-and-set.
  dirtyAt           DateTime?
  /// Earliest next try after a failure (null = as soon as possible).
  nextAttemptAt     DateTime?
  attempts          Int       @default(0)
  lastErrorCode     String?   @db.NVarChar(100)
  /// Provider's error text (≤ 300), shown to the owner / editors only.
  lastErrorMessage  String?   @db.NVarChar(300)
  /// Non-fatal note ("1 attendee has no email and wasn't invited").
  lastWarning       String?   @db.NVarChar(500)
  lastConflictAt    DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  activity   Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([activityId, connectionId])
  @@index([connectionId, state])
  /// Outbox sweep: dirtyAt IS NOT NULL AND (nextAttemptAt IS NULL OR nextAttemptAt <= now).
  @@index([dirtyAt, nextAttemptAt])
}

/// Admin choices for one employee's calendar sync (Admin › API Integrations › People). A row exists only when something
/// differs from the default (provider by email domain, included, no import). Audited (module admin-integrations).
model CalendarSyncUser {
  username       String   @id @db.NVarChar(50)
  /// null = by email domain; google | microsoft | fake (fake only while CALENDAR_FAKE_PROVIDER is on)
  provider       String?  @db.NVarChar(30)
  /// true = never synced (row stopped with reason 'excluded'; events already in the calendar stay)
  excluded       Boolean  @default(false)
  /// Admin's note on why (≤ 200), shown on the People table.
  note           String?  @db.NVarChar(200)
  /// P2-8: bring this person's customer meetings into the CRM (also needs the company switch allowMeetingImport).
  importMeetings Boolean  @default(false)
  updatedBy      String   @db.NVarChar(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

// ── Booking links (Calendar Phase 4) ───────────────────────────────────────────

/// A public scheduling page of one employee (`/book/<slug>`): visitors pick a free time and a meeting activity owned by
/// `ownerUsername` is created (booking-links/bookingLink.public.ts). Free times come from the owner's CRM activities and
/// company calendar (busy times, P2-6). Never hard-deleted: turned off with `isActive`, so an old link stays dead and
/// its slug is never handed to someone else. Audited (entity BookingLink).
model BookingLink {
  id                  String   @id @default(uuid()) @db.NVarChar(50)
  /// `<name>-<title>-<8 random chars>`, generated by the server (never typed), unique for ever. "New address" replaces it.
  slug                String   @unique @db.NVarChar(60)
  /// Whose calendar is offered and who owns the booked activities (username, no FK as everywhere).
  ownerUsername       String   @db.NVarChar(50)
  title               String   @db.NVarChar(120)
  /// Followup Type of the booked activity (not Task / Note), e.g. Meeting, Call, Demo / Presentation.
  followupType        String   @default("Meeting") @db.NVarChar(30)
  /// Durations offered in minutes, JSON array, first = default, e.g. [30,60].
  durationsJson       String   @db.NVarChar(200)
  /// Start times every this many minutes inside a window (15 | 30 | 60).
  slotStepMinutes     Int      @default(30)
  /// Copied to the activity and shown on the page (an address, "Google Meet link follows", a phone number).
  location            String?  @db.NVarChar(250)
  /// Shown to visitors above the times.
  note                String?  @db.NVarChar(1000)
  /// Weekly hours in BUSINESS_TIMEZONE: { "1": [{ "start": "09:00", "end": "13:00" }], … } (ISO weekday 1 = Monday).
  availabilityJson    String   @db.NVarChar(Max)
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  /// No start sooner than this after now.
  minNoticeMinutes    Int      @default(240)
  /// No start later than this many days ahead.
  horizonDays         Int      @default(30)
  /// Bookings of this link per business day; null = no limit.
  maxPerDay           Int?
  /// activity_reminder label for the booked activity; null = none.
  reminder            String?  @db.NVarChar(30)
  askPhone            Boolean  @default(false)
  askCompany          Boolean  @default(false)
  /// Optional related record of every booked activity (CrmModuleKey + id); none by default.
  relatedModule       String?  @db.NVarChar(30)
  relatedId           String?  @db.NVarChar(50)
  isActive            Boolean  @default(true)
  createdBy           String   @db.NVarChar(50)
  updatedBy           String?  @db.NVarChar(50)
  createdAt           DateTime @default(now())
  /// Also the link's version: slot tokens carry it, so an edit voids the times a visitor was shown.
  updatedAt           DateTime @default(now()) @updatedAt

  bookings BookingLinkBooking[]

  @@index([ownerUsername, isActive])
}

/// One booking made on a public booking page: what came in from the internet, the activity it created and the slot
/// token it used (`tokenHash` unique: a token books once; a retried submit gets the same confirmation). Counts the
/// bookings per day (maxPerDay). Visitor details are copied to the activity (attendee, remarks) as well.
model BookingLinkBooking {
  id             String   @id @default(uuid()) @db.NVarChar(50)
  bookingLinkId  String   @db.NVarChar(50)
  /// The Activity created (no FK: activities are soft-deleted and their own aggregate).
  activityId     String   @db.NVarChar(50)
  ownerUsername  String   @db.NVarChar(50)
  startAt        DateTime
  endAt          DateTime
  visitorName    String   @db.NVarChar(100)
  /// Lower-cased.
  visitorEmail   String   @db.NVarChar(120)
  visitorPhone   String?  @db.NVarChar(30)
  visitorCompany String?  @db.NVarChar(200)
  /// The Contact matched by email (exactly one live contact had it), if any.
  contactId      String?  @db.NVarChar(50)
  /// sha256 (hex) of the slot token.
  tokenHash      String   @unique @db.NVarChar(64)
  createdAt      DateTime @default(now())

  bookingLink BookingLink @relation(fields: [bookingLinkId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Bookings per day of a link, and the management page's list (newest first).
  @@index([bookingLinkId, startAt])
  @@index([bookingLinkId, createdAt])
}

// ── Email logging (Calendar Phase 4) ───────────────────────────────────────────

/// One email exchanged between an employee and a CRM contact / lead, logged from the employee's company mailbox (Gmail
/// / Outlook, admin-managed: email-log/emailLog.ingest.ts). Stored once per RFC Message-ID however many employees'
/// mailboxes hold it (LoggedEmailCopy). Headers and a short plain-text snippet only: never a body, HTML, an attachment or
/// Bcc. System data (not audited); deleted by the nightly retention (ModuleSetting activities/emailLogging
/// retentionMonths) or an admin purge.
///
/// Hand-written filtered unique index (migration 20261216100000_email_logging; Prisma can't model filtered indexes):
///   UX_LoggedEmail_messageIdHash (messageIdHash) WHERE messageIdHash IS NOT NULL
model LoggedEmail {
  id             String   @id @default(uuid()) @db.NVarChar(50)
  /// sha256 (hex) of the Message-ID header as sent; null when the message had none (then not deduped across mailboxes).
  messageIdHash  String?  @db.NVarChar(64)
  /// The first copy's provider thread id (Gmail threadId / Graph conversationId); provider-scoped, display only.
  threadId       String?  @db.NVarChar(200)
  subject        String   @db.NVarChar(300)
  /// Lower-cased sender address.
  fromEmail      String   @db.NVarChar(254)
  fromName       String?  @db.NVarChar(200)
  /// JSON [{ email, name? }] of the To recipients (at most 25; lower-cased addresses).
  toJson         String   @db.NVarChar(4000)
  /// JSON [{ email, name? }] of the Cc recipients (at most 25).
  ccJson         String   @db.NVarChar(4000)
  /// To / Cc recipients beyond the 25 + 25 kept.
  moreRecipients Int      @default(0)
  sentAt         DateTime
  /// out = sent from a company domain; in = received from outside.
  direction      String   @db.NVarChar(3)
  /// Plain text (≤ 500), HTML entities decoded; null when the company setting storeSnippets is off.
  snippet        String?  @db.NVarChar(500)
  hasAttachments Boolean  @default(false)
  /// google | microsoft | fake: the provider of the first copy.
  provider       String   @db.NVarChar(30)
  /// Employee whose mailbox logged it first.
  ownerUsername  String   @db.NVarChar(50)
  createdAt      DateTime @default(now())

  copies LoggedEmailCopy[]
  links  LoggedEmailLink[]

  /// Nightly retention (sentAt older than retentionMonths).
  @@index([sentAt])
  @@index([ownerUsername])
}

/// One employee mailbox that holds a logged email (participants; "Open in Gmail / Outlook" for that employee only).
/// Unique per mailbox message, so re-reading a mailbox never logs twice. Purging a person deletes their copies (and every
/// email left without one).
model LoggedEmailCopy {
  id                String   @id @default(uuid()) @db.NVarChar(50)
  emailId           String   @db.NVarChar(50)
  username          String   @db.NVarChar(50)
  provider          String   @db.NVarChar(30)
  /// Gmail message id / Graph immutable message id.
  providerMessageId String   @db.NVarChar(300)
  providerThreadId  String?  @db.NVarChar(200)
  /// Graph webLink (Outlook on the web); Gmail links are built from the id.
  webLink           String?  @db.NVarChar(1000)
  /// For this employee: out = they sent it (Sent folder / sender), in = they received it.
  direction         String   @db.NVarChar(3)
  /// The mailbox's own address is the sender or in To / Cc (or it is the sender's copy). False = the employee got it as
  /// Bcc or through a list: listed as a participant only to that employee, never to other viewers.
  addressed         Boolean  @default(false)
  createdAt         DateTime @default(now())

  email LoggedEmail @relation(fields: [emailId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([username, providerMessageId])
  @@index([emailId])
}

/// A logged email shown on a CRM record (contacts | leads | opportunities). sentAt is copied from the email for the
/// record's newest-first list.
model LoggedEmailLink {
  id           String   @id @default(uuid()) @db.NVarChar(50)
  emailId      String   @db.NVarChar(50)
  /// contacts | leads | opportunities (CRM module key).
  module       String   @db.NVarChar(20)
  recordId     String   @db.NVarChar(50)
  /// The address that matched (the opportunity's contact's address for opportunities).
  matchedEmail String?  @db.NVarChar(120)
  sentAt       DateTime
  createdAt    DateTime @default(now())

  email LoggedEmail @relation(fields: [emailId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([emailId, module, recordId])
  @@index([module, recordId, sentAt])
}

/// One employee's email logging: the admin's switch (mode, audited) and the ingestion state (cursor, health, lease). A
/// row is created on the first admin change or the first run. Employees can't change it (they see their status on My
/// Profile). Usernames are strings, as everywhere (no FK to Users).
model LoggedEmailMailbox {
  username            String    @id @db.NVarChar(50)
  /// on | off; null = the company default (ModuleSetting activities/emailLogging defaultForPeople).
  mode                String?   @db.NVarChar(10)
  modeUpdatedBy       String?   @db.NVarChar(50)
  modeUpdatedAt       DateTime?
  /// Mailbox the cursor belongs to (a provider or email change starts a new cursor).
  provider            String?   @db.NVarChar(30)
  accountEmail        String?   @db.NVarChar(254)
  /// Gmail { historyId } / Graph { inbox, sent } delta links. Not a credential, but never logged.
  cursorJson          String?   @db.NVarChar(Max)
  /// idle (never run) | ok | error
  status              String    @default("idle") @db.NVarChar(20)
  /// user | app (app = the whole provider, e.g. the mail scope isn't granted)
  errorLevel          String?   @db.NVarChar(10)
  lastErrorCode       String?   @db.NVarChar(50)
  /// Admin text (≤ 300; never shown to the employee, never logged at info).
  lastErrorMessage    String?   @db.NVarChar(300)
  lastErrorAt         DateTime?
  consecutiveFailures Int       @default(0)
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  /// Earliest next run (poll interval, or the error backoff 15 min → 1 h → 6 h → 24 h).
  nextRunAt           DateTime?
  /// Emails this mailbox added (new logged emails or copies) since the row was created or last purged.
  loggedCount         Int       @default(0)
  /// When the person's own switch last turned logging on (effective mode off → on). Mail sent / received before
  /// max(this, purgedAt, the company enabledAt / defaultOnAt) is never logged, so turning logging off and on again
  /// can't catch up on the off period.
  loggingSince        DateTime?
  /// Per-mailbox mutex of the ingestion runs (an admin purge takes it too).
  leaseId             String?   @db.NVarChar(50)
  leaseUntil          DateTime?
  /// Last admin purge: mail from before it is never logged again; a run that started before it drops what it stored.
  purgedAt            DateTime?
  purgedBy            String?   @db.NVarChar(50)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([status, nextRunAt])
}
