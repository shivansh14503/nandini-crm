# ── Server ───────────────────────────────────────────────────────────────────
# Must match the frontend's NEXT_PUBLIC_API_PORT (default 8008).
PORT=8008
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8007
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Authentication ───────────────────────────────────────────────────────────
# Required in production (≥ 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session lifetime in seconds (JWT expiry, auth cookie and Redis session TTL). Default 8 hours.
SESSION_TTL_SECONDS=28800
# Failed login attempts allowed per IP per window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ── Database (SQL Server / Azure SQL) ────────────────────────────────────────
# Either set DATABASE_URL …
# DATABASE_URL="sqlserver://your-server.database.windows.net:1433;database=CRM_DB;user=crmadmin;password={your_password};encrypt=true;trustServerCertificate=false"
# … or the individual DB_* values below (DATABASE_URL is built from them when it is not set).
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_DATABASE=CRM_DB
DB_USER=crmadmin
DB_PASSWORD=your_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
# Connection timeout in ms (default 30000; recommended >= 30000 for Azure SQL Serverless cold starts)
DB_CONNECTION_TIMEOUT=30000
# Ping the DB every N ms so the first request of the day is not slow (default 0 disables; set e.g. 240000 = 4 min to keep warm).
# Note: on Azure SQL Serverless, non-zero values prevent auto-pause and bill compute continuously.
# Background jobs wake the database only at these times (all BUSINESS_TIMEZONE), so it can still pause overnight:
#   • 00:05 Lead Rating ageing, 00:15 audit ledger digest, 00:20 notification purge + reminder re-arm;
#   • 09:00 the morning summary email (MORNING_SUMMARY_CRON, Mon–Sat; skipped entirely while mail is off);
#   • every 15 minutes 07:00–21:45 the reminder sweep (contract renewals, missed activity reminders);
#   • once per due activity reminder (a delayed job fires at its time);
#   • every minute ONLY while Redis is down (the workers' fallback check).
# The navbar bell's unread count is served from Redis, so open browser tabs don't keep the database awake (it is
# re-read from SQL only after a change to the user's notifications, at about 00:21 and when Redis comes back).
DB_KEEPALIVE_INTERVAL_MS=0

# ── Redis (cache, rate limiting, sessions, BullMQ) ───────────────────────────
# Optional in local dev: the API degrades gracefully when Redis is unreachable
# (imports of ≤ 500 rows then run inside the request; audit events are written directly).
REDIS_URL=redis://localhost:6379
# Run the background workers (imports, audit, lead rating, reminders / notifications, mail / morning email) inside the API.
# Set false when running `npm run worker` as its own process. Reminders need one of the two.
RUN_WORKERS=true

# ── Business settings ────────────────────────────────────────────────────────
# Timezone of wall-clock values entered in forms (ticket due dates) and of audit timeline times.
BUSINESS_TIMEZONE=Asia/Kolkata

# ── PDF generation (Puppeteer / Chromium) ────────────────────────────────────
# Concurrent Chromium pages rendering PDFs (extra requests wait their turn).
PDF_MAX_CONCURRENCY=3
# Abort a render that takes longer than this (ms).
PDF_RENDER_TIMEOUT_MS=15000
# Cache rendered record PDFs in Redis for N seconds (0 disables). Keys include the template version and record updatedAt.
PDF_CACHE_TTL_SECONDS=600
# Use an installed Chrome / Chromium instead of the one Puppeteer downloads (`npx puppeteer browsers install chrome`).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Launch Chromium with --no-sandbox (Docker containers running as root). Leave false elsewhere.
PDF_CHROMIUM_NO_SANDBOX=false

# ── Email verification ───────────────────────────────────────────────────────
# Saved lead / contact / organization emails are checked in the background: syntax, common-provider typos,
# disposable domains and DNS (domain exists and accepts mail). Set false to turn it off.
EMAIL_VERIFICATION_ENABLED=true
# Optional: adds the "does this mailbox exist" check via https://quickemailverification.com
# (100 free checks/day; unknown results aren't charged). Leave empty to run only the free checks.
QUICKEMAILVERIFICATION_API_KEY=
# Admin bulk checks of at least this many addresses use the provider's List API (one CSV upload, polled for
# status; no callback URL needed). Smaller checks call the single-address API per address.
EMAIL_VERIFICATION_LIST_API_MIN=1000
# A checked address stays checked while it is in the database (no periodic re-check); admins re-check
# addresses in bulk under Settings › Email Validation.

# ── Audit log (Admin › Audit Log) ───────────────────────────────────────────
# Where audit log exports (CSV / Excel) are written; each file is removed 24 hours later. Default: the OS temp folder.
# When workers run in their own process (`npm run worker`), point the API and the workers at the same shared folder.
# AUDIT_EXPORT_DIR=/var/lib/nandini-crm/audit-exports
# Where the nightly ledger digests are saved (default: ./storage/audit-digests). They prove the audit log hasn't been
# altered, so keep them OUTSIDE the database server, ideally on storage the database's admins can't change
# (e.g. an immutable / WORM blob container mounted here), and back them up.
# AUDIT_DIGEST_DIR=/mnt/audit-digests
# Longest a "Verify integrity" run may take (ms). It reads the whole ledger: about 100 s per million entries.
AUDIT_VERIFY_TIMEOUT_MS=1800000

# ── Notifications (navbar bell, reminders, morning summary) ──────────────────
# Activity reminders, assignments, invitations and contract renewal reminders are delivered by the reminders worker
# (RUN_WORKERS=true in the API, or `npm run worker`). Read notifications older than this many days are deleted
# nightly; unread ones after twice that.
NOTIFICATION_RETENTION_DAYS=90
# The morning summary email (today's activities, overdue activities, follow-ups due / overdue, contract renewals)
# to every active user with an email address. Needs the MAIL settings below; false turns it off.
MORNING_SUMMARY_ENABLED=true
# When it is sent, in BUSINESS_TIMEZONE (cron: minute hour day-of-month month day-of-week). Default 09:00 Mon–Sat.
# A run missed while no worker was up is made up once when a worker starts before 12:00 that day.
MORNING_SUMMARY_CRON=0 9 * * 1-6
# Users with nothing due get no email.
MORNING_SUMMARY_SKIP_EMPTY=true

# ── Outgoing email (SMTP) ────────────────────────────────────────────────────
# Off until MAIL_ENABLED=true and SMTP_HOST is set; until then nothing is sent (the morning summary can still be
# previewed from the bell). Two supported setups:
#  1. Google Workspace SMTP relay (recommended): Admin console › Apps › Google Workspace › Gmail › Routing ›
#     SMTP relay service › Add: allowed senders "Only addresses in my domains", authentication "Only accept mail
#     from the specified IP addresses" (the server's public IP), "Require TLS encryption" on. Then
#     SMTP_HOST=smtp-relay.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER/SMTP_PASS empty, and
#     SMTP_EHLO_NAME set to the server's host name (the relay refuses a bare `localhost` greeting).
#  2. A crm@nandiniinfosys.com mailbox with an app password: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#     SMTP_SECURE=false, SMTP_USER=crm@nandiniinfosys.com, SMTP_PASS=<16-character app password>.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# true = TLS from the first byte (port 465); false = STARTTLS on 587, which is required: if the server doesn't offer
# it the send fails rather than going out (with SMTP_PASS) unencrypted.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_EHLO_NAME=
MAIL_FROM="Nandini CRM <crm@nandiniinfosys.com>"
# Address users open the CRM at, for links in emails (default: CLIENT_ORIGIN), e.g. https://crm.nandiniinfosys.com
APP_PUBLIC_URL=
# Outgoing email log (EmailLog table) rows older than this many days are deleted nightly.
EMAIL_LOG_RETENTION_DAYS=180

# ── Integrations (Google / Microsoft / Zoom) ─────────────────────────────────
# Admin › API Integrations stores each provider's client ID and secret in the database, sealed with AES-256-GCM under
# this key (src/services/secretBox.ts). It is the only integrations secret on the server. Unset: the app runs, the
# admin page says "Encryption key not set" and no secret can be saved. Malformed: the API refuses to start.
# Generate one (a different key per environment: laptop, server):
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Set the SAME value for the API and the worker (npm run worker / RUN_WORKERS), restart both, and keep a copy in the
# company password manager: losing it means re-entering the client secrets and everyone reconnecting their calendar.
# Rotation: put the new key first and keep the old one (k2:<new>,k1:<old>), restart, run
# `npm run integrations:reencrypt -- --dry-run`, then `npm run integrations:reencrypt`, then drop k1 and restart.
INTEGRATIONS_ENCRYPTION_KEY=
# Public base URL of this API as browsers and Google / Microsoft reach it, no trailing slash: OAuth redirect URIs and
# webhook URLs are built from it (shown on Admin › API Integrations to copy into Google Cloud / Entra). Default
# http://localhost:<PORT> outside production; unset in production = calendar connections stay off. Google refuses bare
# IP addresses, so test on http://localhost:8008 and go live with https://crm.nandiniinfosys.com (webhooks need https).
PUBLIC_API_URL=

# ── Seeding (`npm run seed`) ─────────────────────────────────────────────────
# Admin account created on first seed. Leave the password empty to have one generated and printed once.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Demo data (users + CRM records from prisma/seed-data/demo/*.json). Defaults to on outside production.
# SEED_DEMO_DATA=true
# Shared password for demo users; when empty they get random passwords and can't sign in.
# SEED_USER_PASSWORD=
