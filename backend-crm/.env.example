# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://your-frontend-domain.vercel.app

# Authentication
JWT_SECRET=generate_a_secure_random_key_for_production

# MSSQL Database Configuration (Azure SQL)
DB_USER=crmadmin
DB_PASSWORD=your_azure_sql_password
DB_SERVER=your-azure-server.database.windows.net
DB_DATABASE=CRM_DB
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false

