# ── Server ───────────────────────────────────────────────────────────────────
# Must match the frontend's NEXT_PUBLIC_API_PORT (default 8008).
PORT=8008
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8007
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Authentication ───────────────────────────────────────────────────────────
# Required in production (≥ 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session lifetime in seconds (JWT expiry, auth cookie and Redis session TTL). Default 8 hours.
SESSION_TTL_SECONDS=28800
# Failed login attempts allowed per IP per window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ── Database (SQL Server / Azure SQL) ────────────────────────────────────────
# Either set DATABASE_URL …
# DATABASE_URL="sqlserver://your-server.database.windows.net:1433;database=CRM_DB;user=crmadmin;password={your_password};encrypt=true;trustServerCertificate=false"
# … or the individual DB_* values below (DATABASE_URL is built from them when it is not set).
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_DATABASE=CRM_DB
DB_USER=crmadmin
DB_PASSWORD=your_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
# Connection timeout in ms (default 30000; recommended >= 30000 for Azure SQL Serverless cold starts)
DB_CONNECTION_TIMEOUT=30000

# ── Redis (cache, rate limiting, sessions, BullMQ) ───────────────────────────
# Optional in local dev: the API degrades gracefully when Redis is unreachable
# (imports of ≤ 500 rows then run inside the request; audit events are written directly).
REDIS_URL=redis://localhost:6379
# Run the import/audit workers inside the API. Set false when running `npm run worker` as its own process.
RUN_WORKERS=true

# ── Business settings ────────────────────────────────────────────────────────
# Timezone of wall-clock values entered in forms (ticket due dates) and of audit timeline times.
BUSINESS_TIMEZONE=Asia/Kolkata

# ── Seeding (`npm run seed`) ─────────────────────────────────────────────────
# Admin account created on first seed. Leave the password empty to have one generated and printed once.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Demo data (users + CRM records from prisma/seed-data/demo/*.json). Defaults to on outside production.
# SEED_DEMO_DATA=true
# Shared password for demo users; when empty they get random passwords and can't sign in.
# SEED_USER_PASSWORD=
# Re-import the ISO address master even if it looks up to date.
# SEED_REFRESH_ADDRESS_MASTER=true
