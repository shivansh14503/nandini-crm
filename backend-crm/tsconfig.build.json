{
    // Production build: compiles src/ (including the generated Prisma client) to dist/.
    // tsconfig.json stays typecheck-only and also covers prisma/ and prisma.config.ts.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist",
        "sourceMap": true
    },
    "include": ["src"]
}
